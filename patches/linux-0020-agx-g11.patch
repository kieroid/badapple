+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Boots the A12 GPU (AGX G11P) firmware and runs compute jobs on it.
+ *
+ * Bring-up driver: it sets the firmware up the way tools/gfx-proxy.py does
+ * and, at probe, runs two test kernels and logs whether they wrote what they
+ * should. docs/gpu.md describes the structures. Offsets in comments name the
+ * firmware functions they come from.
+ *
+ * Everything the firmware and GPU see lives in one physically contiguous
+ * chunk. The firmware maps it at CHUNK_VA through the mem-desc table, and the
+ * GPU VM maps it at GVA_BASE and GVA_BASE2 in MMU context SLOT.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/unaligned.h>
+
+#define ASC_CPU_CONTROL		0x44
+#define ASC_CPU_CONTROL_RUN	BIT(4)
+
+#define EP_MSGS			0x20
+#define EP_INTS			0x21
+#define MSG_INIT		(0x81ULL << 48)
+#define MSG_DOORBELL		(0x83ULL << 48)
+#define MSG_CHECK		(0x42ULL << 48)
+
+#define CHUNK_VA		0xffffffffc0000000ULL
+#define CHUNK_SIZE		0x300000
+#define GVA_BASE		0x1100000000ULL
+#define GVA_BASE2		0x1300000000ULL
+#define SLOT			16
+
+#define CH_CP			2
+#define CH_DEVCTRL		12
+#define CH_EVENT		13
+#define CH_KTRACE		15
+#define NR_CHANNELS		17
+
+#define EV			3
+#define DONE_STAMP		0xcafe0003
+
+/* One entry of the ADT's segment-ranges. */
+struct asc_segment {
+	__le64 phys;
+	__le64 iova;
+	__le64 remap;
+	__le32 size;
+	__le32 flags;
+} __packed;
+
+struct agx {
+	struct device *dev;
+	struct apple_rtkit *rtk;
+	const struct asc_segment *segs;
+	int nsegs;
+	phys_addr_t sgx, fender;
+
+	void *buf;		/* the chunk */
+	bool ready;		/* channels set up */
+	dma_addr_t pa;
+	u32 off;		/* bump allocator */
+	u32 B, C, stats_cp;
+	u32 chan_state[NR_CHANNELS], chan_ring[NR_CHANNELS];
+	u32 ring, info, nr_cmds;	/* the CP command queue */
+};
+
+static u32 agx_alloc(struct agx *agx, u32 n, u32 align)
+{
+	u32 o = ALIGN(agx->off, align);
+
+	if (WARN_ON(o + n > CHUNK_SIZE))
+		return 0;
+	agx->off = o + n;
+	return o;
+}
+
+static u64 fw_va(u32 o)
+{
+	return CHUNK_VA + o;
+}
+
+static u64 gpu_va(u32 o)
+{
+	return GVA_BASE + o;
+}
+
+static void put32(struct agx *agx, u32 o, u32 v)
+{
+	put_unaligned_le32(v, agx->buf + o);
+}
+
+static void put64(struct agx *agx, u32 o, u64 v)
+{
+	put_unaligned_le64(v, agx->buf + o);
+}
+
+static u32 get32(struct agx *agx, u32 o)
+{
+	return get_unaligned_le32(agx->buf + o);
+}
+
+static u32 fw_off(u64 va)
+{
+	return va - CHUNK_VA;
+}
+
+/*
+ * Init block per FUN_00025954. Region layout follows m1n1's G13 InitData
+ * where the G11 firmware matches it.
+ */
+static void agx_build(struct agx *agx, void *init, void *table, dma_addr_t table_pa)
+{
+	static const u32 rings[NR_CHANNELS] = {
+		[0 ... 11] = 0x30 * 0x100,
+		[12] = 0x30 * 0x100, [13] = 0x38 * 0x100, [14] = 6 * 0xd8 * 0x100,
+		[15] = 0x70 * 0x200, [16] = 0x60 * 0x100,
+	};
+	static const struct { u32 off, size; } bufs[] = {
+		/* TA/3D/CP stats, hwdata A, fault info, TLB generations, ... */
+		{ 0x170, 0x1000 }, { 0x178, 0x1000 }, { 0x180, 0x1000 },
+		{ 0x188, 0x20000 }, { 0x190, 0x80 }, { 0x198, 0xc0 },
+		{ 0x1b0, 0x4000 }, { 0x1b8, 0x1000 }, { 0x1c0, 0x300 },
+		{ 0x1c8, 0x1000 }, { 0x220, 0x4000 },
+	};
+	static const u16 scratch_maps[] = {
+		0x680, 0x6e0, 0x700, 0x720, 0x740, 0x760, 0x780, 0x7c0, 0x7e0,
+		0x800, 0x820, 0x840, 0x880, 0x8a0, 0x8c0, 0x8e0, 0x900,
+	};
+	/* ADT sgx/perf-states */
+	static const u32 mhz[] = { 0, 316, 456, 612, 740, 900, 1098 };
+	static const u32 mv[] = { 400, 609, 675, 734, 790, 859, 965 };
+	static const u32 mv_sram[] = { 400, 728, 737, 787, 850, 925, 1046 };
+	/* page size, PA shift, index shift, entries, table size, valid, PA mask, index mask */
+	static const struct { u8 esz, pas, pas2, ish; u16 n; u16 valid; u64 pam, im; } lv[] = {
+		{ 4, 4, 12, 30, 0x1000, 1, 0xfffffff0, 0xffc0000000 },
+		{ 8, 10, 10, 21, 0x800, 1, 0xfffffffc00, 0x3fe00000 },
+		{ 8, 12, 12, 14, 0x200, 1, 0xfffffff000, 0x1fc000 },
+	};
+	static const u64 gvas[] = { GVA_BASE, GVA_BASE2 };
+	u32 B, C, st, hb, ha, pc, pd = 0, pt = 0, ttbr;
+	int i, j, k;
+
+	B = agx->B = agx_alloc(agx, 0x8000, 0x4000);	/* RegionB */
+	C = agx->C = agx_alloc(agx, 0x10000, 0x4000);	/* RegionC */
+	/* Firmware mem-desc ring: {state, 256 entries of 0x14}. */
+	st = agx_alloc(agx, 0x4000, 0x4000);
+	put64(agx, st, fw_va(agx_alloc(agx, 0x100, 0x100)));
+	put64(agx, st + 8, fw_va(agx_alloc(agx, 0x100 * 0x14, 0x4000)));
+	/* 12 run queues, DevCtrl, Event, FWLog, KTrace, Stats */
+	for (i = 0; i < NR_CHANNELS; i++) {
+		agx->chan_state[i] = agx_alloc(agx, 0x100, 0x100);
+		agx->chan_ring[i] = agx_alloc(agx, rings[i], 0x4000);
+		put64(agx, B + i * 0x10, fw_va(agx->chan_state[i]));
+		put64(agx, B + i * 0x10 + 8, fw_va(agx->chan_ring[i]));
+	}
+	hb = agx_alloc(agx, 0x4000, 0x4000);
+	for (i = 0; i < ARRAY_SIZE(bufs); i++)
+		put64(agx, B + bufs[i].off, fw_va(agx_alloc(agx, bufs[i].size, 0x4000)));
+	put64(agx, B + 0x1a0, fw_va(hb));
+	put64(agx, B + 0x1a8, fw_va(hb));
+	ha = fw_off(get_unaligned_le64(agx->buf + B + 0x188));
+	agx->stats_cp = fw_off(get_unaligned_le64(agx->buf + B + 0x180));
+
+	/* hwdata B IO maps, 0x20 each: phys, fw va (firmware fills it), size, rw */
+	put64(agx, hb + 0x640, agx->fender);
+	put64(agx, hb + 0x650, 0x20000);
+	put32(agx, hb + 0x658, 1);
+	put64(agx, hb + 0x6a0, agx->sgx);
+	put64(agx, hb + 0x6b0, 0x20000);
+	put32(agx, hb + 0x6b8, 1);
+	/*
+	 * The firmware maps the others only when the PA is set (FUN_00028ad0)
+	 * but uses them anyway, so point them at scratch RAM.
+	 */
+	for (i = 0; i < ARRAY_SIZE(scratch_maps); i++) {
+		put64(agx, hb + scratch_maps[i], agx->pa + agx_alloc(agx, 0x8000, 0x4000));
+		put64(agx, hb + scratch_maps[i] + 0x10, 0x8000);
+		put32(agx, hb + scratch_maps[i] + 0x18, 1);
+	}
+	/* Real power mode: the firmware asks Fender for a perf state. */
+	put32(agx, hb + 0x958, 1);
+	put32(agx, hb + 0x960, 1);
+	/*
+	 * Sample periods in 24 MHz ticks, 16 ms. At 0 the power thread's
+	 * timers fire back to back and starve agx_background.
+	 */
+	put32(agx, hb + 0x988, 16000 * 24);
+	put32(agx, ha + 4, 16000 * 24);
+	/* Highest pstate; the DVFS loop in FUN_00020b44 walks down from it. */
+	put32(agx, hb + 0xa6c, ARRAY_SIZE(mhz) - 1);
+	/* VA bases; power-up loads +0x18 into RGX 0x10000. */
+	put64(agx, hb, 0x1400000000);
+	put64(agx, hb + 8, 0xffc00000);
+	put64(agx, hb + 0x10, GVA_BASE);
+	put64(agx, hb + 0x18, GVA_BASE);
+	put64(agx, hb + 0x20, 0x18ffff8000);
+	/*
+	 * Unit masks for TA, 3D and CP, copied by FUN_000157b4. At 0 the
+	 * scheduler never finds a free unit.
+	 */
+	put32(agx, hb + 0x16d0, 3);
+	put32(agx, hb + 0x16d4, 7);
+	put32(agx, hb + 0x16d8, 1);
+	for (i = 0; i < ARRAY_SIZE(mhz); i++) {
+		put32(agx, hb + 0xa70 + 4 * i, mhz[i]);
+		for (j = 0; j < 8; j++) {
+			put32(agx, hb + 0xab0 + 0x20 * i + 4 * j, mv[i]);
+			put32(agx, hb + 0xcb0 + 0x20 * i + 4 * j, mv_sram[i]);
+		}
+	}
+
+	/*
+	 * GPU VM, a PowerVR Rogue S7 MMU with 16K pages. Page catalogue u32
+	 * (pd >> 12) << 4 | 1 for VA[39:30], page directory pt | 3 for
+	 * VA[29:21], page table page | 1 for VA[20:14]. Both bases map the
+	 * whole chunk.
+	 */
+	pc = agx_alloc(agx, 0x4000, 0x4000);
+	for (k = 0; k < ARRAY_SIZE(gvas); k++) {
+		pd = agx_alloc(agx, 0x4000, 0x4000);
+		put32(agx, pc + (gvas[k] >> 30) * 4, (agx->pa + pd) >> 12 << 4 | 1);
+		for (i = 0; i < CHUNK_SIZE >> 14; i++) {
+			if (i % 128 == 0) {
+				pt = agx_alloc(agx, 0x400, 0x400);
+				put64(agx, pd + ((gvas[k] >> 21) & 0x1ff) * 8 + i / 128 * 8,
+				      agx->pa + pt + 3);
+			}
+			put64(agx, pt + i % 128 * 8, agx->pa + i * 0x4000 + 1);
+		}
+	}
+	/*
+	 * Per-context TLB generations, page catalogues, and the contexts
+	 * FUN_00026338 loads at every power-up.
+	 */
+	put64(agx, C + 0x9150, fw_va(agx_alloc(agx, 0x100, 0x100)));
+	ttbr = agx_alloc(agx, 0x4000, 0x4000);
+	put64(agx, C + 0x9158, fw_va(ttbr));
+	put64(agx, ttbr + SLOT * 8, agx->pa + pc);
+	put32(agx, C + 0x9160, BIT(SLOT));
+	/* All trace categories, drained in agx_drain(). */
+	put32(agx, C, 0xff);
+	/* The first power-up installs the job handlers only when set. */
+	put32(agx, C + 0xb1cc, 1);
+
+	/* Mem-desc table: va, pa >> 12, 0, 16K pages, flags */
+	put_unaligned_le64(CHUNK_VA, table);
+	put_unaligned_le32(agx->pa >> 12, table + 8);
+	put_unaligned_le16(CHUNK_SIZE >> 14, table + 0x10);
+	put_unaligned_le16(1, table + 0x12);
+
+	put_unaligned_le64(fw_va(B), init + 3 * 8);
+	put_unaligned_le64(fw_va(C), init + 4 * 8);
+	put_unaligned_le64(fw_va(st), init + 5 * 8);
+	/* MMU format for the firmware's own walks (FUN_00026744) */
+	put_unaligned_le16(0x4000, init + 0x30);
+	*(u8 *)(init + 0x32) = 14;
+	*(u8 *)(init + 0x33) = ARRAY_SIZE(lv);
+	for (i = 0; i < ARRAY_SIZE(lv); i++) {
+		void *p = init + 0x34 + i * 0x20;
+
+		*(u8 *)p = lv[i].esz;
+		*(u8 *)(p + 1) = lv[i].pas;
+		*(u8 *)(p + 2) = lv[i].pas2;
+		*(u8 *)(p + 3) = lv[i].ish;
+		put_unaligned_le16(lv[i].n, p + 4);
+		put_unaligned_le16(0x4000, p + 6);
+		put_unaligned_le64(lv[i].valid, p + 8);
+		put_unaligned_le64(lv[i].pam, p + 0x10);
+		put_unaligned_le64(lv[i].im, p + 0x18);
+	}
+	put_unaligned_le64(table_pa, init + 0x13 * 8);
+	put_unaligned_le64(1, init + 0x14 * 8);
+}
+
+/* Event and KTrace: mark everything read, so the rings never fill. */
+static void agx_drain(struct agx *agx)
+{
+	static const struct { int ch; u32 count; } rings[] = {
+		{ CH_EVENT, 0x100 }, { CH_KTRACE, 0x200 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rings); i++) {
+		u32 st = agx->chan_state[rings[i].ch];
+		u32 w = READ_ONCE(*(u32 *)(agx->buf + st + 0x20));
+
+		if (w < rings[i].count)
+			WRITE_ONCE(*(u32 *)(agx->buf + st), w);
+	}
+}
+
+static void agx_doorbell(struct agx *agx, u32 ch)
+{
+	wmb();
+	apple_rtkit_send_message(agx->rtk, EP_INTS, MSG_DOORBELL | ch, NULL, false);
+}
+
+/*
+ * One command queue on the CP channel, CommandQueueInfo as in m1n1 with the
+ * context pointer at +0xa4.
+ */
+static void agx_queue(struct agx *agx)
+{
+	u32 ptrs, jl, gbuf, ctx, info;
+
+	if (agx->info)
+		return;
+	ptrs = agx_alloc(agx, 0x100, 0x100);
+	agx->ring = agx_alloc(agx, 0x800, 0x100);
+	jl = agx_alloc(agx, 0x100, 0x100);
+	gbuf = agx_alloc(agx, 0x4000, 0x4000);
+	ctx = agx_alloc(agx, 0x100, 0x100);
+	info = agx->info = agx_alloc(agx, 0x100, 0x100);
+
+	put32(agx, ptrs + 0x50, 0x100);
+	/* job list, a TAILQ head {first, last = &first} */
+	put64(agx, jl + 8, fw_va(jl));
+	*(u8 *)(agx->buf + ctx) = 0xff;
+	*(u8 *)(agx->buf + ctx + 1) = 0xff;
+	*(u8 *)(agx->buf + ctx + 5) = 1;
+	*(u8 *)(agx->buf + ctx + 0x1e) = 0xff;
+	*(u8 *)(agx->buf + ctx + 0x23) = 2;
+	put64(agx, info, fw_va(ptrs));
+	put64(agx, info + 8, fw_va(agx->ring));
+	put64(agx, info + 0x10, fw_va(jl));
+	put64(agx, info + 0x18, fw_va(gbuf));
+	put32(agx, info + 0x2c, -1);
+	put64(agx, info + 0x38, 0xffffffffffff0000);
+	put32(agx, info + 0x40, 1);
+	put32(agx, info + 0x48, 1);
+	put32(agx, info + 0x4c, -1);
+	put32(agx, info + 0x50, 0x1001);
+	put32(agx, info + 0x54, -1);
+	put64(agx, info + 0xa4, fw_va(ctx));
+}
+
+/*
+ * The run message is {type, info, head, queue index, flush}: FUN_000075fc
+ * stores head at info+0x28 and FUN_0001fb60 runs the ring up to it. Later
+ * commands go in the same queue with the next head.
+ */
+static void agx_submit(struct agx *agx, u32 cmd)
+{
+	u32 st = agx->chan_state[CH_CP];
+	u32 n = agx->nr_cmds++;
+	u32 msg = agx->chan_ring[CH_CP] + n * 0x30;
+
+	put64(agx, agx->ring + n * 8, fw_va(cmd));
+	memset(agx->buf + msg, 0, 0x30);
+	put32(agx, msg, CH_CP);
+	put64(agx, msg + 4, fw_va(agx->info));
+	put32(agx, msg + 0xc, n + 1);
+	put32(agx, msg + 0x10, EV);
+	put32(agx, msg + 0x14, 1);
+	put32(agx, st + 0x20, n + 1);
+	agx_doorbell(agx, CH_CP);
+}
+
+/*
+ * A compute command in MMU context SLOT that launches the state block at
+ * state over grid threads in groups of group. Microsequence as the kext
+ * builds it (FUN_fffffff0084d0f08): StartCompute, wait for the CDM
+ * interrupt, finalize, end. Returns the offset of the stamp that reads
+ * DONE_STAMP once the job is done.
+ */
+static u32 agx_compute(struct agx *agx, u32 state, u32 grid, u32 group)
+{
+	u32 cmd = agx_alloc(agx, 0x300, 0x100);
+	u32 evc = agx_alloc(agx, 0x100, 0x100);
+	u32 useq = agx_alloc(agx, 0x200, 0x100);
+	u32 scratch = agx_alloc(agx, 0x100, 0x100);
+	u32 stream = agx_alloc(agx, 0x4000, 0x4000);
+	u32 args = agx_alloc(agx, 0x4000, 0x4000);
+	u32 fin = useq + 0x64 + 4;
+	static const u32 launch_tail[] = { 1, 1, 0, 1, 1, 0xc0000160, 0x80000000 };
+	int i;
+
+	agx_queue(agx);
+
+	/*
+	 * CDM: launch with header 3 (bit 0 always set, one uniform block),
+	 * the state block with its low bits 4 (one block of 8 registers),
+	 * grid and threadgroup size; barrier; terminate.
+	 */
+	put32(agx, stream, 3);
+	put32(agx, stream + 4, (gpu_va(state) & 0xffffffc0) | 4);
+	put32(agx, stream + 8, grid);
+	for (i = 0; i < ARRAY_SIZE(launch_tail); i++)
+		put32(agx, stream + 0xc + 4 * i, i == 2 ? group : launch_tail[i]);
+
+	put64(agx, scratch + 0x20, 1);			/* kick gate */
+
+	/* StartCompute, 0x64 bytes */
+	put32(agx, useq, 0x29);
+	put64(agx, useq + 4, fw_va(cmd + 0x1c));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x70));
+	put64(agx, useq + 0x14, fw_va(agx->stats_cp));
+	put64(agx, useq + 0x1c, fw_va(agx->info));
+	put32(agx, useq + 0x24, SLOT);
+	put32(agx, useq + 0x2c, SLOT);
+	put64(agx, useq + 0x3c, fw_va(cmd + 0x1fc));
+	put64(agx, useq + 0x4c, fw_va(cmd + 0x2d8));
+	put64(agx, useq + 0x5c, fw_va(scratch + 0x20));
+	/* wait for the CDM interrupt */
+	put32(agx, useq + 0x64, 0x41);
+	/* finalize, 0x44 bytes */
+	put32(agx, fin, 0x2a);
+	put64(agx, fin + 4, fw_va(agx->stats_cp));
+	put64(agx, fin + 0xc, fw_va(agx->info));
+	put32(agx, fin + 0x14, SLOT);
+	put64(agx, fin + 0x18, fw_va(cmd + 0x1fc));
+	put64(agx, fin + 0x28, fw_va(scratch + 8));
+	put32(agx, fin + 0x30, 1);
+	put32(agx, fin + 0x38, -(0x64 + 4));
+	put64(agx, fin + 0x3c, fw_va(cmd + 0x2d8));
+	/* end */
+	put32(agx, fin + 0x44, 0x18 | 0x40 << 24);
+
+	put32(agx, cmd, 3);
+	put32(agx, cmd + 0x10, SLOT);
+	put64(agx, cmd + 0x14, fw_va(evc));
+	/* event control: +0 points at the counter finalize bumps */
+	put64(agx, evc, fw_va(scratch + 8));
+	put64(agx, cmd + 0x70, gpu_va(args));
+	put64(agx, cmd + 0x78, gpu_va(stream));
+	put64(agx, cmd + 0x1f0, fw_va(useq));
+	put32(agx, cmd + 0x1f8, fin + 0x48 - useq);
+	/* completion stamp {target, ?, value, event} */
+	put64(agx, cmd + 0x278, fw_va(scratch + 0x10));
+	put32(agx, cmd + 0x288, DONE_STAMP);
+	put32(agx, cmd + 0x28c, EV);
+
+	agx_submit(agx, cmd);
+	return scratch + 0x10;
+}
+
+/*
+ * Code and state block. The state block is uniform DMAs (3 | first << 9 |
+ * count << 21 | VA << 24, 32-bit registers from u0), the shader word (code
+ * >> 6 at bit 38, 0x9 at 31:28, one block of 8 registers), then 0x0108 for
+ * no preshader. G11 stop is 0x0801.
+ */
+static u32 agx_shader(struct agx *agx, const u8 *prog, size_t len,
+		      const u32 *uniforms, int nr_uniforms)
+{
+	u32 code = agx_alloc(agx, 0x400, 0x4000);
+	u32 state = agx_alloc(agx, 0x40, 0x40);
+	u32 o = state;
+	int i;
+
+	memcpy(agx->buf + code, prog, len);
+	if (nr_uniforms) {
+		u32 ubuf = agx_alloc(agx, nr_uniforms * 4, 0x100);
+
+		for (i = 0; i < nr_uniforms; i++)
+			put32(agx, ubuf + 4 * i, uniforms[i]);
+		put64(agx, o, gpu_va(ubuf) << 24 | (u64)nr_uniforms << 21 | 3);
+		o += 8;
+	}
+	put64(agx, o, (gpu_va(code) & 0xffffffff) >> 6 << 38 | 0x90000000 | 0x1f);
+	put_unaligned_le16(0x0108, agx->buf + o + 8);
+	return state;
+}
+
+static u32 agx_out(struct agx *agx, int n)
+{
+	u32 o = agx_alloc(agx, n * 4, 0x4000);
+	int i;
+
+	for (i = 0; i < n; i++)
+		put32(agx, o + 4 * i, 0xdeadbeef);
+	return o;
+}
+
+static int agx_wait(struct agx *agx, u32 stamp)
+{
+	u32 v;
+
+	return readx_poll_timeout(READ_ONCE, *(u32 *)(agx->buf + stamp), v,
+				  v == DONE_STAMP, 1000, 2000000);
+}
+
+static void agx_check(struct agx *agx, const char *name, u32 stamp, u32 o,
+		      int n, u32 base)
+{
+	int i, bad = 0, first = -1;
+
+	if (agx_wait(agx, stamp)) {
+		dev_err(agx->dev, "%s: job did not complete\n", name);
+		return;
+	}
+	for (i = 0; i < n; i++) {
+		if (get32(agx, o + 4 * i) != base + i) {
+			bad++;
+			if (first < 0)
+				first = i;
+		}
+	}
+	if (bad)
+		dev_err(agx->dev, "%s: %d of %d wrong, first [%d] = %#x\n", name, bad,
+			n, first, get32(agx, o + 4 * first));
+	else
+		dev_info(agx->dev, "%s: ok\n", name);
+}
+
+/*
+ * get_sr r3, thread_position_in_grid.x; mov_imm r0, r1 = out; device_store
+ * r3 to r0_r1 + r3 * 4; wait; stop.
+ */
+static void agx_test_tid(struct agx *agx)
+{
+	u8 prog[] = {
+		0xf2, 0x0d, 0x10, 0x04,
+		0x62, 0x01, 0, 0, 0, 0,
+		0x62, 0x05, 0, 0, 0, 0,
+		0x45, 0x19, 0x60, 0x06, 0x00, 0xc0, 0x12, 0x00,
+		0x38, 0x00, 0x08, 0x01,
+	};
+	u32 o = agx_out(agx, 256);
+
+	put_unaligned_le32(lower_32_bits(gpu_va(o)), prog + 6);
+	put_unaligned_le32(upper_32_bits(gpu_va(o)), prog + 12);
+	agx_check(agx, "tid", agx_compute(agx, agx_shader(agx, prog, sizeof(prog), NULL, 0),
+					  256, 32), o, 256, 0);
+}
+
+/*
+ * u0_u1 = out, u2 = 0x5a000000. get_sr r3; iadd r4 = r3 + u2; device_store
+ * r4 to u0_u1 + r3 * 4; wait; stop.
+ */
+static void agx_test_uniform(struct agx *agx)
+{
+	static const u8 prog[] = {
+		0xf2, 0x0d, 0x10, 0x04,
+		0x0e, 0x11, 0x46, 0x42, 0x18, 0x00, 0x00, 0x00,
+		0x45, 0x21, 0x60, 0x0e, 0x00, 0xc0, 0x12, 0x00,
+		0x38, 0x00, 0x08, 0x01,
+	};
+	u32 o = agx_out(agx, 64);
+	u32 u[] = { lower_32_bits(gpu_va(o)), upper_32_bits(gpu_va(o)), 0x5a000000 };
+
+	agx_check(agx, "uniform", agx_compute(agx, agx_shader(agx, prog, sizeof(prog), u, 3),
+					      64, 32), o, 64, 0x5a000000);
+}
+
+static int agx_shmem_setup(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	struct agx *agx = cookie;
+	int i;
+
+	/* Address 0 asks the host to pick one. */
+	if (!bfr->iova) {
+		bfr->buffer = dmam_alloc_coherent(agx->dev, bfr->size, &bfr->iova,
+						  GFP_KERNEL);
+		return bfr->buffer ? 0 : -ENOMEM;
+	}
+
+	for (i = 0; i < agx->nsegs; i++) {
+		u64 iova = le64_to_cpu(agx->segs[i].iova);
+		u32 size = le32_to_cpu(agx->segs[i].size);
+
+		if (bfr->iova < iova || bfr->iova + bfr->size > iova + size)
+			continue;
+
+		bfr->buffer = devm_memremap(agx->dev, le64_to_cpu(agx->segs[i].phys) +
+					    bfr->iova - iova, bfr->size, MEMREMAP_WB);
+		return PTR_ERR_OR_ZERO(bfr->buffer);
+	}
+
+	dev_warn(agx->dev, "refusing buffer of %#zx bytes at %pad\n", bfr->size,
+		 &bfr->iova);
+	return -ENOMEM;
+}
+
+/* devm frees and unmaps the buffers with the device. */
+static void agx_shmem_destroy(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+}
+
+static void agx_recv(void *cookie, u8 ep, u64 msg)
+{
+	struct agx *agx = cookie;
+
+	/* 0x42 only says "check the channels". */
+	if (msg == MSG_CHECK && READ_ONCE(agx->ready))
+		agx_drain(agx);
+	else if (msg != MSG_CHECK)
+		dev_info(agx->dev, "ep %#x: %#018llx\n", ep, msg);
+}
+
+static void agx_crashed(void *cookie, const void *log, size_t size)
+{
+	struct agx *agx = cookie;
+
+	dev_err(agx->dev, "firmware crashed\n");
+}
+
+static const struct apple_rtkit_ops agx_rtk_ops = {
+	.crashed = agx_crashed,
+	.recv_message = agx_recv,
+	.shmem_setup = agx_shmem_setup,
+	.shmem_destroy = agx_shmem_destroy,
+};
+
+static int agx_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	dma_addr_t init_pa, table_pa;
+	void *init, *table, *buf;
+	void __iomem *base;
+	struct agx *agx;
+	u32 v;
+	int len, ret;
+
+	agx = devm_kzalloc(dev, sizeof(*agx), GFP_KERNEL);
+	if (!agx)
+		return -ENOMEM;
+	agx->dev = dev;
+	agx->segs = of_get_property(dev->of_node, "apple,segment-ranges", &len);
+	agx->nsegs = agx->segs ? len / sizeof(*agx->segs) : 0;
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sgx");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no sgx registers\n");
+	agx->sgx = res->start;
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "fender");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no fender registers\n");
+	agx->fender = res->start;
+
+	/* DRAM starts at 0x800000000, past the default 32 bit mask. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+
+	base = devm_platform_ioremap_resource_byname(pdev, "asc");
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	agx->rtk = devm_apple_rtkit_init(dev, agx, NULL, 0, &agx_rtk_ops);
+	if (IS_ERR(agx->rtk))
+		return dev_err_probe(dev, PTR_ERR(agx->rtk), "RTKit init failed\n");
+
+	writel(ASC_CPU_CONTROL_RUN, base + ASC_CPU_CONTROL);
+
+	ret = apple_rtkit_boot(agx->rtk);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware did not boot\n");
+	ret = apple_rtkit_start_ep(agx->rtk, EP_MSGS);
+	if (!ret)
+		ret = apple_rtkit_start_ep(agx->rtk, EP_INTS);
+	if (ret)
+		return dev_err_probe(dev, ret, "endpoints did not start\n");
+	msleep(500);
+
+	init = dmam_alloc_coherent(dev, SZ_16K, &init_pa, GFP_KERNEL);
+	table = dmam_alloc_coherent(dev, SZ_16K, &table_pa, GFP_KERNEL);
+	buf = dmam_alloc_coherent(dev, CHUNK_SIZE, &agx->pa, GFP_KERNEL);
+	if (!init || !table || !buf)
+		return -ENOMEM;
+	agx->buf = buf;
+	agx_build(agx, init, table, table_pa);
+	wmb();
+	WRITE_ONCE(agx->ready, true);
+
+	apple_rtkit_send_message(agx->rtk, EP_MSGS, MSG_INIT | init_pa, NULL, false);
+	ret = readx_poll_timeout(READ_ONCE, *(u32 *)(buf + agx->C + 0xb198), v, v,
+				 10000, 2000000);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware did not take the init block\n");
+
+	/*
+	 * Device control type 0x1b only stores its argument, but it also
+	 * brings the GPU up, which sets up the scheduler state jobs need.
+	 */
+	put32(agx, agx->chan_ring[CH_DEVCTRL], 0x1b);
+	put64(agx, agx->chan_ring[CH_DEVCTRL] + 4, 0x1122334455667788);
+	put32(agx, agx->chan_state[CH_DEVCTRL] + 0x20, 1);
+	agx_doorbell(agx, 0x11);
+	ret = readx_poll_timeout(READ_ONCE, *(u32 *)(buf + agx->chan_state[CH_DEVCTRL]), v,
+				 v == 1, 10000, 3000000);
+	if (ret)
+		return dev_err_probe(dev, ret, "device control message not taken\n");
+	msleep(1000);
+	dev_info(dev, "firmware up, chunk at %pad\n", &agx->pa);
+
+	agx_test_tid(agx);
+	agx_test_uniform(agx);
+	return 0;
+}
+
+static const struct of_device_id agx_of_match[] = {
+	{ .compatible = "apple,t8020-agx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, agx_of_match);
+
+static struct platform_driver agx_driver = {
+	.driver = {
+		.name = "apple-agx-g11",
+		.of_match_table = agx_of_match,
+	},
+	.probe = agx_probe,
+};
+module_platform_driver(agx_driver);
+
+MODULE_AUTHOR("kiki <kieran@lavato.net>");
+MODULE_DESCRIPTION("Apple A12 GPU (AGX G11P) bring-up driver");
+MODULE_LICENSE("Dual MIT/GPL");
