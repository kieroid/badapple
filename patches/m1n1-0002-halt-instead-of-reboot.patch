diff --git a/src/exception.c b/src/exception.c
index ded20c4..fa7a5ba 100644
--- a/src/exception.c
+++ b/src/exception.c
@@ -355,8 +355,8 @@ void exc_sync(u64 *regs)
             break;
         case GUARD_OFF:
         default:
-            printf("Unhandled exception, rebooting...\n");
-            flush_and_reboot();
+            printf("Unhandled exception, halting...\n");
+            flush_and_halt();
     }
 
     exc_count++;
@@ -471,9 +471,50 @@ void exc_serr(u64 *regs)
     if (!(exc_guard & GUARD_SILENT))
         print_regs(regs, 0);
 
+    /*
+     * Bring-up on T8020: report an unhandled SError and keep going rather than
+     * halting.
+     *
+     * An SError is asynchronous and imprecise, so the PC in the dump is only
+     * wherever execution happened to be, in our case inside vsnprintf. What is
+     * reproducible is L2C_ERR_ADR, which reads 0x8ec78c000 on every boot,
+     * exactly the "Top of normal RAM" that memory.c prints. So it is an access
+     * at the top of DRAM boundary. It survived removing the phram log buffer
+     * that first appeared responsible, and it is latched well before it is
+     * taken.
+     *
+     * Halting stops the boot with no way to find out whether the error matters.
+     * Continuing is a deliberate shortcut: if the kernel boots afterwards it
+     * was benign at the boundary, and if things misbehave we know it was not.
+     */
     if ((exc_guard & GUARD_TYPE_MASK) == GUARD_OFF) {
-        printf("Unhandled exception, rebooting...\n");
-        flush_and_reboot();
+        static bool serr_masked = false;
+
+        if (!serr_masked) {
+            serr_masked = true;
+
+            /*
+             * Clear the recursive flag too. print_regs above only clears
+             * ACCESS_FAULT and PIO_FAULT, but our status reads 0x...82, which
+             * is ACCESS_FAULT and RECURSIVE_FAULT. ENABLE_W1C is set as well,
+             * so a read-modify-write of zeroes may not clear anything.
+             */
+            reg_mask(SYS_IMP_APL_L2C_ERR_STS,
+                     L2C_ERR_STS_ACCESS_FAULT | L2C_ERR_STS_PIO_FAULT |
+                         L2C_ERR_STS_RECURSIVE_FAULT,
+                     0);
+
+            /*
+             * Then mask SError outright. Returning from the handler without
+             * the error actually cleared re-asserts it immediately and the
+             * boot spins printing this dump forever, which is what it did.
+             * Masking breaks that loop whether or not the clear above worked.
+             * Linux sets its own DAIF early, so it does not inherit this.
+             */
+            msr(DAIF, mrs(DAIF) | (4 << 6));
+
+            printf("Unhandled SError at top of RAM: masked, continuing (T8020 bring-up)\n");
+        }
     }
 
     exc_count++;
diff --git a/src/utils.c b/src/utils.c
index feeca69..801e6af 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -140,6 +140,14 @@ void flush_and_reboot(void)
     reboot();
 }
 
+void flush_and_halt(void)
+{
+    printf("\n*** Halted so this stays readable. Hold Side + Volume Down to reset. ***\n");
+    iodev_console_flush();
+    while (1)
+        sysop("wfe");
+}
+
 void spin_init(spinlock_t *lock)
 {
     lock->lock = -1;
diff --git a/src/utils.h b/src/utils.h
index 429db16..2b74425 100644
--- a/src/utils.h
+++ b/src/utils.h
@@ -421,6 +421,13 @@ u64 ticks_to_usecs(u64 ticks);
 
 void reboot(void) __attribute__((noreturn));
 void flush_and_reboot(void) __attribute__((noreturn));
+/*
+ * Like flush_and_reboot, but stop instead of rebooting, so whatever was just
+ * printed stays on the framebuffer long enough to read. On a phone that
+ * framebuffer is the only console available without a serial cable on the
+ * Lightning pins, and a reboot takes the message with it.
+ */
+void flush_and_halt(void) __attribute__((noreturn));
 
 u64 timeout_calculate(u32 usec);
 bool timeout_expired(u64 timeout);
@@ -447,7 +454,7 @@ void spin_unlock(spinlock_t *lock);
 #define panic(fmt, ...)                                                                            \
     do {                                                                                           \
         debug_printf(fmt, ##__VA_ARGS__);                                                          \
-        flush_and_reboot();                                                                        \
+        flush_and_halt();                                                                          \
     } while (0)
 
 static inline int poll32(u64 addr, u32 mask, u32 target, u32 timeout)
