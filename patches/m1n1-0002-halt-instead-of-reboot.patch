@@ -421,6 +421,13 @@ u64 ticks_to_usecs(u64 ticks);
 
 void reboot(void) __attribute__((noreturn));
 void flush_and_reboot(void) __attribute__((noreturn));
+/*
+ * Like flush_and_reboot, but stop instead of rebooting, so whatever was just
+ * printed stays on the framebuffer long enough to read. On a phone that
+ * framebuffer is the only console available without a serial cable on the
+ * Lightning pins, and a reboot takes the message with it.
+ */
+void flush_and_halt(void) __attribute__((noreturn));
 
 u64 timeout_calculate(u32 usec);
 bool timeout_expired(u64 timeout);
@@ -447,7 +454,7 @@ void spin_unlock(spinlock_t *lock);
