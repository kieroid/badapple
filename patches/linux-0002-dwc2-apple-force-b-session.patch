+		/* Clear it by hand too, in case core_connect declined. */
+		dwc2_clear_bit(hsotg, DCTL, DCTL_SFTDISCON);
+		dev_info(hsotg->dev, "apple: after manual clear: DCTL=0x%08x\n",
+			 dwc2_readl(hsotg, DCTL));
+	}
