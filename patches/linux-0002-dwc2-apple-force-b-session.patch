diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index 102169b40..2e885561f 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -22,6 +22,7 @@
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/slab.h>
+#include <linux/of.h>
 
 #include <linux/usb/ch9.h>
 #include <linux/usb/gadget.h>
@@ -4577,6 +4578,56 @@ static int dwc2_hsotg_udc_start(struct usb_gadget *gadget,
 	}
 
 	hsotg->enabled = 0;
+
+	/*
+	 * Apple A-series: nothing wires VBUS sensing, so the controller never
+	 * asserts B-session valid and dwc2_hsotg_pullup() bails out early
+	 * because op_state is not B_PERIPHERAL, leaving the soft disconnect
+	 * set. The gadget then binds, logs "bound driver", and is invisible to
+	 * every host. Force the session, claim peripheral role, and connect
+	 * here rather than waiting for a VBUS event that cannot arrive.
+	 */
+	if (of_device_is_compatible(hsotg->dev->of_node, "apple,dwc2")) {
+		u32 gotgctl = dwc2_readl(hsotg, GOTGCTL);
+
+		gotgctl |= GOTGCTL_DBNCE_FLTR_BYPASS;
+		gotgctl |= GOTGCTL_BVALOEN | GOTGCTL_BVALOVAL;
+		gotgctl |= GOTGCTL_AVALOEN | GOTGCTL_VBVALOEN;
+		dwc2_writel(hsotg, gotgctl, GOTGCTL);
+
+		hsotg->op_state = OTG_STATE_B_PERIPHERAL;
+		hsotg->enabled = 1;
+
+		dev_info(hsotg->dev,
+			 "apple: before: GOTGCTL=0x%08x DCTL=0x%08x GINTSTS=0x%08x curmod=%d\n",
+			 dwc2_readl(hsotg, GOTGCTL), dwc2_readl(hsotg, DCTL),
+			 dwc2_readl(hsotg, GINTSTS),
+			 !!(dwc2_readl(hsotg, GINTSTS) & GINTSTS_CURMODE_HOST));
+		dev_info(hsotg->dev,
+			 "apple: GRSTCTL=0x%08x GAHBCFG=0x%08x GUSBCFG=0x%08x PCGCTL=0x%08x\n",
+			 dwc2_readl(hsotg, GRSTCTL), dwc2_readl(hsotg, GAHBCFG),
+			 dwc2_readl(hsotg, GUSBCFG), dwc2_readl(hsotg, PCGCTL));
+
+		/*
+		 * Device registers are inert while the core sits in host mode,
+		 * which is why DCTL writes were being swallowed. Force device
+		 * mode before touching anything else.
+		 */
+		dwc2_force_mode(hsotg, false);
+		dev_info(hsotg->dev, "apple: after force device mode: curmod=%d DCTL=0x%08x\n",
+			 !!(dwc2_readl(hsotg, GINTSTS) & GINTSTS_CURMODE_HOST),
+			 dwc2_readl(hsotg, DCTL));
+
+		dwc2_hsotg_core_connect(hsotg);
+		dev_info(hsotg->dev, "apple: after core_connect: DCTL=0x%08x\n",
+			 dwc2_readl(hsotg, DCTL));
+
+		/* Clear it by hand too, in case core_connect declined. */
+		dwc2_clear_bit(hsotg, DCTL, DCTL_SFTDISCON);
+		dev_info(hsotg->dev, "apple: after manual clear: DCTL=0x%08x\n",
+			 dwc2_readl(hsotg, DCTL));
+	}
+
 	spin_unlock_irqrestore(&hsotg->lock, flags);
 
 	gadget->sg_supported = using_desc_dma(hsotg);
@@ -4705,6 +4756,64 @@ static int dwc2_hsotg_pullup(struct usb_gadget *gadget, int is_on)
 		/* Enable ACG feature in device mode,if supported */
 		dwc2_enable_acg(hsotg);
 		dwc2_hsotg_core_connect(hsotg);
+
+		/*
+		 * Nothing in the peripheral only path ever sets the global
+		 * interrupt enable. dwc2_enable_global_interrupts() is reached
+		 * from hcd.c, or from the core_intr.c handlers, which cannot
+		 * run until interrupts already work. With dr_mode =
+		 * "peripheral" this platform never goes near the HCD, so
+		 * GAHBCFG stays 0, dwc2_read_common_intr() returns 0 for every
+		 * interrupt, and USBRst and EnumDone are never handled, so
+		 * enumeration cannot complete.
+		 */
+		dwc2_set_bit(hsotg, GAHBCFG, GAHBCFG_GLBL_INTR_EN);
+
+		dev_info(hsotg->dev,
+			 "pullup on: DCTL=0x%08x GAHBCFG=0x%08x GOTGCTL=0x%08x GINTSTS=0x%08x\n",
+			 dwc2_readl(hsotg, DCTL), dwc2_readl(hsotg, GAHBCFG),
+			 dwc2_readl(hsotg, GOTGCTL), dwc2_readl(hsotg, GINTSTS));
+
+		/*
+		 * Which registers actually take a write?
+		 *
+		 * Reads here agree with what m1n1 sees over its own proxy on the
+		 * same silicon, but writes to GAHBCFG, DCTL and GOTGCTL all read
+		 * back unchanged. m1n1 writes the same registers and they stick,
+		 * so this narrows it down: if some of these take a write and
+		 * others do not, the ones that do not are special, and if none
+		 * of them do then nothing this driver writes has ever landed and
+		 * the problem is the mapping rather than the core.
+		 */
+		{
+			u32 was, now;
+
+			was = dwc2_readl(hsotg, GINTMSK);
+			dwc2_writel(hsotg, 0x00003000, GINTMSK);
+			now = dwc2_readl(hsotg, GINTMSK);
+			dev_info(hsotg->dev, "wtest GINTMSK  %08x -> %08x (wrote 00003000)\n",
+				 was, now);
+
+			was = dwc2_readl(hsotg, DIEPMSK);
+			dwc2_writel(hsotg, 0x0000000d, DIEPMSK);
+			now = dwc2_readl(hsotg, DIEPMSK);
+			dev_info(hsotg->dev, "wtest DIEPMSK  %08x -> %08x (wrote 0000000d)\n",
+				 was, now);
+
+			was = dwc2_readl(hsotg, GAHBCFG);
+			dwc2_writel(hsotg, 0x0000002e, GAHBCFG);
+			now = dwc2_readl(hsotg, GAHBCFG);
+			dev_info(hsotg->dev, "wtest GAHBCFG  %08x -> %08x (wrote 0000002e)\n",
+				 was, now);
+
+			was = dwc2_readl(hsotg, DCTL);
+			dwc2_writel(hsotg, 0x00000000, DCTL);
+			now = dwc2_readl(hsotg, DCTL);
+			dev_info(hsotg->dev, "wtest DCTL     %08x -> %08x (wrote 00000000)\n",
+				 was, now);
+
+			dev_info(hsotg->dev, "regs=%p\n", hsotg->regs);
+		}
 	} else {
 		dwc2_hsotg_core_disconnect(hsotg);
 		dwc2_hsotg_disconnect(hsotg);
