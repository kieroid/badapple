  * @irq: The IRQ number triggered
  * @pw: The pw value when registered the handler.
  */
+/*
+ * The host sees the attach and the high speed chirp but every control
+ * transfer times out, which is what it looks like when nothing services the
+ * bus. Count interrupts so a dump can tell "the handler never runs" apart
+ * from "it runs and gets nowhere".
+ */
+static unsigned int apple_irq_count;
+static struct dwc2_hsotg *apple_dbg_hsotg;
+static int apple_dbg_left;
+
+static void apple_dbg_dump(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = apple_dbg_hsotg;
+
+	dev_info(hsotg->dev,
+		 "apple dbg: irqs=%u GINTSTS=0x%08x GINTMSK=0x%08x DSTS=0x%08x DCFG=0x%08x DCTL=0x%08x DAINT=0x%08x\n",
+		 apple_irq_count, dwc2_readl(hsotg, GINTSTS),
+		 dwc2_readl(hsotg, GINTMSK), dwc2_readl(hsotg, DSTS),
+		 dwc2_readl(hsotg, DCFG), dwc2_readl(hsotg, DCTL),
+		 dwc2_readl(hsotg, DAINT));
+
+	if (--apple_dbg_left > 0)
+		schedule_delayed_work(to_delayed_work(work),
+				      msecs_to_jiffies(4000));
+}
+
+static DECLARE_DELAYED_WORK(apple_dbg_work, apple_dbg_dump);
+
 static irqreturn_t dwc2_hsotg_irq(int irq, void *pw)
 {
