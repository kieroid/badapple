+static unsigned int apple_irqs, apple_setups;
+static struct usb_ctrlrequest apple_last_ctrl;
+static struct dwc2_hsotg *apple_report_hsotg;
+
+static void apple_report_fn(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = apple_report_hsotg;
+
+	dev_info(hsotg->dev,
+		 "apple: irqs=%u setups=%u last=%02x %02x %04x ep0_state=%d DSTS=%08x DCFG=%08x GINTSTS=%08x DOEPCTL0=%08x DIEPCTL0=%08x\n",
+		 apple_irqs, apple_setups, apple_last_ctrl.bRequestType,
+		 apple_last_ctrl.bRequest, le16_to_cpu(apple_last_ctrl.wValue),
+		 hsotg->ep0_state, dwc2_readl(hsotg, DSTS),
+		 dwc2_readl(hsotg, DCFG), dwc2_readl(hsotg, GINTSTS),
+		 dwc2_readl(hsotg, DOEPCTL(0)), dwc2_readl(hsotg, DIEPCTL(0)));
+}
+static DECLARE_DELAYED_WORK(apple_report, apple_report_fn);
