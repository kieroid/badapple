+
+// Boot menu rows, 96 pixels each, drawn over a cleared screen
+#define MENU_SCALE 3
+#define MENU_ROW   (32 * MENU_SCALE)
+
+void chainload_menu_clear(void)
+{
+    fb_clear((rgb_t){0});
+    fb_text(MENU_ROW / 2, MENU_ROW, "germin8", 7, MENU_SCALE, false);
+    fb_text(MENU_ROW / 2, MENU_ROW * 2 + MENU_ROW / 2, "Volume moves, side boots", 24, 2, false);
+}
+
+void chainload_menu_line(u32 row, const char *text, size_t len, bool selected)
+{
+    fb_text(MENU_ROW / 2, MENU_ROW * (4 + row), text, len, MENU_SCALE, selected);
+}
