+// Large text without the console, for the boot menu: the retina font, scaled
+void fb_text(u32 x, u32 y, const char *s, size_t len, u32 scale, bool invert)
+{
+    if (!console.initialized)
+        return;
+
+    for (size_t n = 0; n < len && x + 16 * scale <= fb.width; n++, x += 16 * scale) {
+        u8 c = s[n] < 0x20 || s[n] > 0x7e ? '?' : s[n];
+        const u8 *glyph = _binary_build_font_retina_bin_start + (c - 0x20) * 16 * 32;
+
+        for (u32 i = 0; i < 32 * scale; i++) {
+            for (u32 j = 0; j < 16 * scale; j++) {
+                u8 v = glyph[(i / scale) * 16 + j / scale];
+                if (invert)
+                    v = ~v;
+                fb_set_pixel(x + j, y + i, (rgb_t){.r = v, .g = v, .b = v});
+            }
+        }
+    }
+    fb_update();
+}
