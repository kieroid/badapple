+/*
+ * Offset from the PHY register base back to the USB complex control register,
+ * and the enable bit in it. The ADT puts otgphyctrl at complex_base + 0x60.
+ */
+#define AUSB_COMPLEX_FROM_PHY		0x60
+#define AUSB_COMPLEX_CTL		0x00
+#define AUSB_COMPLEX_CTL_EN		BIT(0)
+
 static int ausb_phy_usb2_power_on(struct phy *phy)
 {
 	struct ausb_usbphy *aphy = phy_get_drvdata(phy);
+	void __iomem *complex;
+
+	/*
+	 * Enable the USB complex before touching anything else. Nothing else in
+	 * Linux does this: the complex is bound to simple-pm-bus, which powers
+	 * the domain but never writes the enable bit. m1n1 does it explicitly
+	 * and its gadget works on this SoC, and m1n1 disables USB again on
+	 * handoff, so by the time Linux runs the block is inert and every write
+	 * to the PHY and to dwc2's device registers is silently dropped.
+	 */
+	complex = ioremap(aphy->reg_base - AUSB_COMPLEX_FROM_PHY, 4);
+	if (complex) {
+		set32(complex + AUSB_COMPLEX_CTL, AUSB_COMPLEX_CTL_EN);
+		dev_info(aphy->dev, "apple phy: complex CTL=0x%08x\n",
+			 readl(complex + AUSB_COMPLEX_CTL));
+		iounmap(complex);
+	} else {
+		dev_err(aphy->dev, "apple phy: could not map usb complex\n");
+	}
 
 	/* set a sane tunable */
 	writel(aphy->cfg0_device, aphy->base + AUSB_CFG0);
@@ -108,7 +136,32 @@ static int ausb_phy_usb2_power_on(struct phy *phy)
 	udelay(20);
 	clear32(aphy->base + AUSB_CTL, AUSB_CTL_RESET);
 	udelay(1500);
-	set32(aphy->base + AUSB_SIG, AUSB_SIG_VBUSDET_FORCE_EN);
+
+	/*
+	 * Select device mode. ausb_phy_usb2_set_mode() is #if 0'd out in this
+	 * driver, so nothing ever clears AUSB_SIG_HOST and the PHY keeps
+	 * whatever role iBoot left it in. If that is host, dwc2's device
+	 * register block is inert: DCTL and GOTGCTL writes are silently
+	 * dropped, the soft disconnect can never be cleared, and the gadget
+	 * binds but is invisible to every host.
+	 */
+	clear32(aphy->base + AUSB_SIG, AUSB_SIG_HOST);
+
+	/*
+	 * Leave forced VBUS detection OFF here, so the real detector runs.
+	 *
+	 * m1n1 brings this same PHY up successfully on this SoC and clears
+	 * VBUSDET_FORCE_EN at this point, only setting it again after the dwc2
+	 * core has been initialised. This driver was instead setting it before
+	 * dwc2 init and never clearing it, which pins detection to a value
+	 * sampled while the PHY is still settling: SIG bit 8, CABLE_CONNECTED,
+	 * then reads 0 forever and will not accept a write, the core never sees
+	 * a session, and DCTL keeps its soft disconnect so no host can see us.
+	 */
+	clear32(aphy->base + AUSB_SIG, AUSB_SIG_VBUSDET_FORCE_EN);
+
+	dev_info(aphy->dev, "apple phy: power_on done CTL=0x%08x SIG=0x%08x\n",
+		 readl(aphy->base + AUSB_CTL), readl(aphy->base + AUSB_SIG));
 
 	return 0;
 }
