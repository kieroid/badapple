diff --git a/src/usb_complex.h b/src/usb_complex.h
index 58f33ca..9ffb973 100644
--- a/src/usb_complex.h
+++ b/src/usb_complex.h
@@ -51,6 +51,24 @@
 #define USBX_EHCI1_REMAP_CTL_T8015  0x38
 #define USBX_USBDEV_REMAP_CTL_T8015 0x48
 
+/*
+ * T8020 registers.
+ *
+ * The ADT lists these in /arm-io/usb-complex usb_widget_with_mask as three
+ * (offset, value, mask) triplets: offsets 0x28, 0x38 and 0x48, value 0x88,
+ * mask 0x030000ff. That mask covers bits 0-7 and 24-25, which is exactly the
+ * T8011 bit layout, so the values are shared and only the offsets differ.
+ * T8020 has three widgets, for usb-device, usb-ehci0 and usb-ohci0, with no
+ * second EHCI. m1n1 writes the same value to each, so which widget is which
+ * does not matter here.
+ *
+ * Do not lean on the usb-complex,t8011 fallback compatible for these. T8015
+ * carries the same fallback and still needs its own offsets.
+ */
+#define USBX_WIDGET0_REMAP_CTL_T8020 0x28
+#define USBX_WIDGET1_REMAP_CTL_T8020 0x38
+#define USBX_WIDGET2_REMAP_CTL_T8020 0x48
+
 /* USB PHY registers */
 
 #define USBX_OTG_CTL       0x00
@@ -95,6 +113,7 @@ enum usb_complex_type {
     USBCOMPLEX_S5L8960X,
     USBCOMPLEX_T8011,
     USBCOMPLEX_T8015,
+    USBCOMPLEX_T8020,
 };
 
