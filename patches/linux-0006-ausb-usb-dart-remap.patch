diff --git a/drivers/phy/apple/ausb.c b/drivers/phy/apple/ausb.c
--- a/drivers/phy/apple/ausb.c
+++ b/drivers/phy/apple/ausb.c
@@ -103,6 +103,8 @@
 #define AUSB_COMPLEX_CTL		0x00
 #define AUSB_COMPLEX_CTL_EN		BIT(0)
 #define AUSB_COMPLEX_REMAP		0x48
+#define AUSB_COMPLEX_REMAP_FIELDS	0x030000ff
+#define AUSB_COMPLEX_REMAP_DMA_EN	(BIT(24) | BIT(25))
 
 static int ausb_phy_usb2_power_on(struct phy *phy)
 {
@@ -126,6 +128,24 @@
 	complex = ioremap_np(aphy->reg_base - AUSB_COMPLEX_FROM_PHY, 0x1000);
 	if (complex) {
 		set32(complex + AUSB_COMPLEX_CTL, AUSB_COMPLEX_CTL_EN);
+		/*
+		 * The two top bits of this widget register are the DMA enables,
+		 * both directions, and the low byte is a value it splices into
+		 * bits 35:32 of every address the controller emits. Clearing
+		 * the enables on a live gadget leaves it enumerated and kills
+		 * every transfer, so they go on.
+		 *
+		 * The splice value stays zero. The widget is in front of the
+		 * DART, so anything spliced in here is what the DART has to
+		 * have a mapping for, and dwc2 is a 32 bit master: the DMA
+		 * layer will never hand it an address above 4GB to match. The
+		 * DART is what reaches DRAM, which starts at 0x800000000.
+		 *
+		 * Masked rather than written whole, the way the ADT's own
+		 * usb_widget_with_mask entry for this offset does it.
+		 */
+		mask32(complex + AUSB_COMPLEX_REMAP, AUSB_COMPLEX_REMAP_FIELDS,
+		       AUSB_COMPLEX_REMAP_DMA_EN);
 		dev_info(aphy->dev, "apple phy: complex CTL=0x%08x REMAP=0x%08x\n",
 			 readl(complex + AUSB_COMPLEX_CTL),
 			 readl(complex + AUSB_COMPLEX_REMAP));
