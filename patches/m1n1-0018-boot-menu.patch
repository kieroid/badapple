+// Keys up to 4 bytes; the value comes back in the reply itself
+int smc_read(smc_dev_t *smc, u32 key, void *buf, size_t size)
+{
+    assert(size <= 4);
+    u8 id = smc->msgid & 0xF;
+    u64 msg = FIELD_PREP(SMC_MSG_TYPE, SMC_READ_KEY);
+    msg |= FIELD_PREP(SMC_WRITE_KEY_SIZE, size);
+    msg |= FIELD_PREP(SMC_WRITE_KEY_KEY, key);
+
+    int ret = smc_cmd(smc, msg);
+    if (ret)
+        return ret;
+
+    u32 value = FIELD_GET(SMC_RESULT_VALUE, smc->ret[id]);
+    memcpy(buf, &value, size);
+    return 0;
+}
+
