     {MIDR_PART_T8015_MONSOON, "A11 Monsoon", init_t8015_monsoon, &features_a11},
     {MIDR_PART_T8015_MISTRAL, "A11 Mistral", init_t8015_mistral, &features_a11},
+    /*
+     * A12. midr.h already defined these part IDs but nothing referenced them,
+     * so the lookup fell through to features_unknown, where
+     * apple_sysregs_unlocked is false. That sends an A12 into the M4-only
+     * branch of kboot_prepare_dt, which reads CTRR_M4_LWR_EL2: an EL2 register
+     * that does not exist here, read from EL1. It faults with ESR 0x2000000,
+     * EC 0, an undefined system register access, right after the line
+     * "isp: Unsupported SoC".
+     *
+     * No chicken init, the same as the M4 and A18 Pro entries below.
+     * features_a11 is the nearest generation and, importantly, has
+     * apple_sysregs_unlocked set. If one of its other bits is wrong for A12 it
+     * will surface as a new fault with its own PC to resolve.
+     */
+    {MIDR_PART_T8020_VORTEX, "A12 Vortex", NULL, &features_a11},
+    {MIDR_PART_T8020_TEMPSET, "A12 Tempest", NULL, &features_a11},
     {MIDR_PART_T8103_FIRESTORM, "M1 Firestorm", init_t8103_firestorm, &features_m1},
     {MIDR_PART_T6000_FIRESTORM, "M1 Pro Firestorm", init_t6000_firestorm, &features_m1},
     {MIDR_PART_T6001_FIRESTORM, "M1 Max Firestorm", init_t6001_firestorm, &features_m1},
