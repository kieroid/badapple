+/*
+ * The ANS firmware on T8020 crashes with "cmd fetch error for host 0 Admin SQ,
+ * rresp code 2" a few milliseconds after it logs "boot mode normal", which is
+ * before Linux writes ASQ. rresp 2 is an AXI SLVERR, so a read was refused.
+ * One explanation is that the registers still hold what iBoot left, and the
+ * firmware resumes against a queue the SART no longer allows. Print the state
+ * at the two points that would tell the difference.
+ */
+static void apple_nvme_dump_regs(struct apple_nvme *anv, const char *when)
+{
+	dev_dbg(anv->dev,
+		"regs %s: CC=%#x CSTS=%#x INTMS=%#x AQA=%#x ASQ=%#llx "
+		 "ACQ=%#llx CAP=%#llx BOOT_STATUS=%#x CPU_CONTROL=%#x\n",
+		 when,
+		 readl(anv->mmio_nvme + NVME_REG_CC),
+		 readl(anv->mmio_nvme + NVME_REG_CSTS),
+		 readl(anv->mmio_nvme + NVME_REG_INTMS),
+		 readl(anv->mmio_nvme + NVME_REG_AQA),
+		 readq(anv->mmio_nvme + NVME_REG_ASQ),
+		 readq(anv->mmio_nvme + NVME_REG_ACQ),
+		 readq(anv->mmio_nvme + NVME_REG_CAP),
+		 readl(anv->mmio_nvme + APPLE_ANS_BOOT_STATUS),
+		 readl(anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL));
+	dev_dbg(anv->dev,
+		"ans  %s: LINEAR_SQ_CTRL=%#x MAX_PEND=%#x NVMMU_NUM_TCBS=%#x "
+		 "NVMMU_ASQ_TCB=%#llx NVMMU_IOSQ_TCB=%#llx NVMMU_TCB_STAT=%#x\n",
+		 when,
+		 readl(anv->mmio_nvme + APPLE_ANS_LINEAR_SQ_CTRL),
+		 readl(anv->mmio_nvme + APPLE_ANS_MAX_PEND_CMDS_CTRL),
+		 readl(anv->mmio_nvme + APPLE_NVMMU_NUM_TCBS),
+		 readq(anv->mmio_nvme + APPLE_NVMMU_ASQ_TCB_BASE),
+		 readq(anv->mmio_nvme + APPLE_NVMMU_IOSQ_TCB_BASE),
+		 readl(anv->mmio_nvme + APPLE_NVMMU_TCB_STAT));
+}
