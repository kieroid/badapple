+/*
+ * Bring-up: capture syncs to cluster rx_sync's sync generator, clocked from
+ * pin rx_sync through that cluster's clock generator, as iOS does for mca2a
+ * ("syn5", "pin5"). Its frame is rx_period bit clocks. -1 keeps the TX chain.
+ */
+static int rx_sync = -1;
+module_param(rx_sync, int, 0644);
+static uint rx_period = 250;
+module_param(rx_period, uint, 0644);
+
+static int mca_sync_sel(struct mca_cluster *cl, bool is_tx)
+{
+	if (!is_tx && rx_sync >= 0 && rx_sync < cl->host->nclusters)
+		return rx_sync + 1;
+	return cl->sync_cl->no + 1;
+}
