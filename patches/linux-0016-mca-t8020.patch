+/*
+ * Bring-up: write "port,mck[,rate]" to the mclk_out parameter to make a port
+ * drive its MCLK pin from a PMGR MCK all the time. The XS Max codec needs one
+ * on pin 0 for its own clocks, streams or not. MCK n follows NCO channel n by
+ * default, so that NCO runs at the MCLK rate.
+ */
+static struct mca_data *mca_probed;
+
+static void mca_mclk_out_one(struct mca_data *mca, u32 port, u32 mck, u32 rate)
+{
+	struct mca_cluster *cl, *ncl;
+	int ret;
+
+	if (port >= mca->nclusters || mck >= mca->nclusters)
+		return;
+	cl = &mca->clusters[port];
+	ncl = &mca->clusters[mck];
+	ret = clk_set_rate(ncl->clk_parent, rate);
+	if (!ret)
+		ret = clk_prepare_enable(ncl->clk_parent);
+	if (ret) {
+		dev_err(mca->dev, "MCK%u: unable to run at %u Hz: %d\n", mck, rate, ret);
+		return;
+	}
+	ret = pm_runtime_resume_and_get(cl->pd_dev);
+	if (ret < 0) {
+		dev_err(mca->dev, "port %u: unable to power up for MCLK\n", port);
+		return;
+	}
+	writel_relaxed(mck + 1, cl->base + REG_PORT_CLOCK_SEL);
+	mca_modify(cl, REG_PORT_ENABLES, BIT(0), BIT(0));
+	dev_info(mca->dev, "port %u drives MCLK from MCK%u at %lu Hz\n", port, mck,
+		 clk_get_rate(ncl->clk_parent));
+}
+
+static int mca_mclk_out_set(const char *val, const struct kernel_param *kp)
+{
+	u32 port, mck, rate = 12000000;
+
+	if (!mca_probed)
+		return -ENODEV;
+	if (sscanf(val, "%u,%u,%u", &port, &mck, &rate) < 2)
+		return -EINVAL;
+	mca_mclk_out_one(mca_probed, port, mck, rate);
+	return 0;
+}
+
+static const struct kernel_param_ops mca_mclk_out_ops = {
+	.set = mca_mclk_out_set,
+};
+module_param_cb(mclk_out, &mca_mclk_out_ops, NULL, 0200);
