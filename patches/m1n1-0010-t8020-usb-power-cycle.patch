diff --git a/src/usb.c b/src/usb.c
--- a/src/usb.c
+++ b/src/usb.c
@@ -334,8 +334,15 @@
  */
 #define T8020_USB_PS0 0x23b0802a8
 #define T8020_USB_PS1 0x23b0802b0
+/*
+ * The device controller has a domain of its own, and without it the dwc2 core
+ * does not answer and reading GSNPSID data aborts. Linux names all three when
+ * it comes up: "always-on domain usb", "usbctlreg", then "usb2dev", which is
+ * this one.
+ */
+#define T8020_USB_PS2 0x23b0802c0
 
-__attribute__((unused)) static void usb_t8020_ps_set(u64 addr, bool on)
+static void usb_t8020_ps_set(u64 addr, bool on)
 {
     mask32(addr, 0xf, on ? 0xf : 0);
 
@@ -346,13 +353,15 @@
     }
 }
 
-__attribute__((unused)) static void usb_t8020_power_cycle(void)
+static void usb_t8020_power_cycle(void)
 {
-    usb_t8020_ps_set(T8020_USB_PS0, false);
+    usb_t8020_ps_set(T8020_USB_PS2, false);
     usb_t8020_ps_set(T8020_USB_PS1, false);
+    usb_t8020_ps_set(T8020_USB_PS0, false);
     udelay(1000);
     usb_t8020_ps_set(T8020_USB_PS0, true);
     usb_t8020_ps_set(T8020_USB_PS1, true);
+    usb_t8020_ps_set(T8020_USB_PS2, true);
 }
 
 int usb_complex_init(struct usb_complex_config *config)
@@ -398,7 +407,14 @@
              *
              * Only the device remap matters here, so the EHCI and OHCI ones
              * the T8015 case writes are left out.
+             *
+             * The power cycle has to come first. Coming from iBSS rather than
+             * from PongoOS the USB domains are still down, so the dwc2 core
+             * does not answer and reading GSNPSID below data aborts. Linux
+             * needs them up as well, it says so itself: "always-on domain usb
+             * is not on at boot".
              */
+            usb_t8020_power_cycle();
             write32(config->USBComplexBase + USBX_CTL_T8011, USBX_CTL_EN_T8011);
             write32(config->USBComplexBase + USBX_USBDEV_REMAP_CTL_T8015,
                     USBX_REMAP_TO_DRAM_BITS_T8011);
