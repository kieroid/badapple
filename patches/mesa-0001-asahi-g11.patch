+/*
+ * G11's vertex state is a fixed four word token (Metal's
+ * VDMEncoderGen2_1<G11>::VsStateToken), see the GL driver's agx_encode_state.
+ * The varying counts go first, in their own PPP block.
+ */
+static void
+hk_g11_flush_vs(struct hk_cmd_buffer *cmd, struct hk_shader *hw_vs,
+                struct hk_linked_shader *linked, bool varyings_dirty,
+                uint8_t **out)
+{
+   struct hk_graphics_state *gfx = &cmd->state.gfx;
+   unsigned outputs = hw_vs->info.uvs.size;
+
+   if (varyings_dirty) {
+      uint32_t counts[3] = {BITFIELD_RANGE(18, 2)};
+
+      memcpy(&counts[1], &gfx->linked_varyings.counts_32, 4);
+      memcpy(&counts[2], &gfx->linked_varyings.counts_16, 4);
+      hk_g11_ppp(cmd, out, counts, 3);
+   }
+
+   uint32_t *w = (uint32_t *)*out;
+
+   /* 0x8040 rasterization off, 2:1 the provoking vertex */
+   w[0] = 0x48000000 | (hk_rast_discard(cmd) ? 0x8040 : 0) |
+          (gfx->provoking << 1) | agx_g11_vs_class(outputs);
+   gfx->g11_vs_header = w[0];
+
+   struct hk_g11_counts n = hk_g11_counts(cmd, hw_vs, false);
+   agx_pack(&w[1], VDM_STATE_VERTEX_SHADER_WORD_0, cfg) {
+      cfg.uniform_register_count = hw_vs->b.info.push_count;
+      cfg.texture_state_register_count = n.textures;
+      cfg.sampler_state_register_count =
+         agx_translate_sampler_state_count(n.samplers, false);
+   }
+   agx_g11_clear_counts(&w[1], n.textures, n.samplers);
+
+   w[2] = hk_upload_usc_words(cmd, hw_vs, linked) |
+          agx_g11_regs(linked->b.nr_gprs);
+   w[3] = outputs & 0xff;
+   *out += 16;
