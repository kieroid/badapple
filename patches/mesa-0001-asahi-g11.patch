    NIR_PASS(_, nir, nir_opt_constant_folding);
    NIR_PASS(_, nir, nir_opt_combine_barriers, NULL, NULL);
@@ -3502,7 +3642,8 @@ agx_compile_function_nir(nir_shader *nir, nir_function_impl *impl,
