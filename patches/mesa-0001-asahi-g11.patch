--- a/src/asahi/compiler/agx_compiler.h
+++ b/src/asahi/compiler/agx_compiler.h
@@ -6,6 +6,11 @@
 
 #pragma once
 
+/* Target the A12 GPU (G11): the stop instruction is 0x0801, threadgroup
+ * memory goes through the device load/store encoding, and there are no SIMD
+ * reductions or G13 cache barriers. */
+#define AGX_G11 1
+
 #include "asahi/isa/agx_minifloat.h"
 #include "compiler/nir/nir.h"
 #include "util/bitset.h"
