+   if (store) {
+      nir_store_global(b, intr->src[0].ssa, addr,
+                       .write_mask = nir_intrinsic_write_mask(intr),
+                       .align_mul = nir_intrinsic_align_mul(intr),
+                       .align_offset = nir_intrinsic_align_offset(intr));
+      nir_instr_remove(&intr->instr);
+   } else {
