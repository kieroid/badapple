diff --git a/src/asahi/compiler/agx_pack.c b/src/asahi/compiler/agx_pack.c
index 6236c3c..305d307 100644
--- a/src/asahi/compiler/agx_pack.c
+++ b/src/asahi/compiler/agx_pack.c
@@ -779,6 +779,26 @@ agx_pack_instr(struct util_dynarray *emission, struct util_dynarray *fixups,
       unsigned O =
          agx_pack_local_index(I, is_load ? I->src[1] : I->src[2], &Ot);
 
+      if (AGX_G11) {
+         /* G11 has no separate threadgroup opcodes: it uses the device
+          * load/store layout with address space 2 in bits 28-29 and a
+          * 16-bit register base holding the byte address.
+          */
+         pack_assert(I, At == 0 && Ot);
+         uint64_t raw =
+            (is_load ? 0x05 : 0x45) | ((I->format & BITFIELD_MASK(3)) << 7) |
+            ((R & BITFIELD_MASK(6)) << 10) | ((A & BITFIELD_MASK(4)) << 16) |
+            ((O & BITFIELD_MASK(4)) << 20) | (1 << 24) | (2 << 28) |
+            (((uint64_t)((O >> 4) & BITFIELD_MASK(4))) << 32) |
+            (((uint64_t)((A >> 4) & BITFIELD_MASK(4))) << 36) |
+            (((uint64_t)((R >> 6) & BITFIELD_MASK(2))) << 40) |
+            BITFIELD64_BIT(47) | (((uint64_t)(I->format >> 3)) << 48) |
+            (((uint64_t)Rt) << 49) | (((uint64_t)I->mask) << 52) |
+            (((uint64_t)(O >> 8)) << 56);
+         memcpy(util_dynarray_grow_bytes(emission, 1, 8), &raw, 8);
+         break;
+      }
+
       uint64_t raw =
          agx_opcodes_info[I->op].encoding.exact | (Rt ? BITFIELD64_BIT(8) : 0) |
          ((R & BITFIELD_MASK(6)) << 9) | (L ? BITFIELD64_BIT(15) : 0) |
