diff --git a/src/asahi/compiler/agx_compile.c b/src/asahi/compiler/agx_compile.c
index e131bcf..5ce13aa 100644
--- a/src/asahi/compiler/agx_compile.c
+++ b/src/asahi/compiler/agx_compile.c
@@ -977,7 +977,7 @@ translate_atomic_opcode(nir_atomic_op op)
 static agx_index
 agx_local_base(nir_src src)
 {
-   if (nir_src_is_const(src) && nir_src_as_uint(src) == 0)
+   if (!AGX_G11 && nir_src_is_const(src) && nir_src_as_uint(src) == 0)
       return agx_zero();
    else
       return agx_src_index(&src);
@@ -1520,7 +1520,9 @@ agx_emit_intrinsic(agx_builder *b, nir_intrinsic_instr *instr)
             /* Pull out all the big hammers to make cross-workgroup memory
              * barriers work.
              */
-            if (nir_intrinsic_memory_scope(instr) >= SCOPE_QUEUE_FAMILY) {
+            /* G11 kills the thread on all of these but memory_barrier. */
+            if (!AGX_G11 &&
+                nir_intrinsic_memory_scope(instr) >= SCOPE_QUEUE_FAMILY) {
                agx_unknown_barrier_1(b);
                agx_memory_barrier_2(b);
 
@@ -2900,7 +2902,9 @@ agx_optimize_nir(nir_shader *nir, bool soft_fault, uint16_t *preamble_size,
       .lower_subgroup_masks = true,
    };
 
-   NIR_PASS(progress, nir, nir_opt_uniform_atomics, true);
+   /* G11 has no SIMD reductions (simd_iadd kills the thread). */
+   if (!AGX_G11)
+      NIR_PASS(progress, nir, nir_opt_uniform_atomics, true);
 
    /* Lower addressing modes. The sooner we do this, the sooner we get rid of
     * amul/aadd instructions and can let nir_opt_algebraic do its job. But we
@@ -3502,7 +3506,8 @@ agx_compile_function_nir(nir_shader *nir, nir_function_impl *impl,
     */
    bool dump_shaders = agx_should_dump(nir, AGX_DBG_SHADERS);
 #ifndef NDEBUG
-   bool selftest = !dump_shaders;
+   /* The ISA description does not know the G11 threadgroup encoding. */
+   bool selftest = !dump_shaders && !AGX_G11;
 #else
    bool selftest = false;
 #endif
diff --git a/src/asahi/compiler/agx_compiler.h b/src/asahi/compiler/agx_compiler.h
