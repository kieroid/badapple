+/*
+ * G11's stack instructions differ from G13's and are not known yet, so keep
+ * private memory in global memory instead: each thread gets stride bytes at
+ * scratch_base + its index in the dispatch * stride.
+ *
+ * ponytail: sized for the whole grid. Per-core slots like Apple's spill
+ * buffer once the G11 stack instructions are known.
+ */
+static bool
+lower_scratch_to_global(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   unsigned stride = *(unsigned *)data;
+   bool store = intr->intrinsic == nir_intrinsic_store_scratch;
+
+   if (!store && intr->intrinsic != nir_intrinsic_load_scratch)
+      return false;
