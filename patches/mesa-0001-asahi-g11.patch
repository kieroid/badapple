+/*
+ * G11 samples and image writes encode their data and coordinate registers in
+ * six bits (16-bit halves), so those must sit in r0-r31. Whether source s
+ * (-1 for the destination) is such an operand.
+ */
+#define G11_LOW_REGS 64
+
+static bool
+g11_low_operand(const agx_instr *I, int s)
+{
+   if (!AGX_G11)
+      return false;
+
+   switch (I->op) {
+   case AGX_OPCODE_TEXTURE_SAMPLE:
+   case AGX_OPCODE_TEXTURE_LOAD:
+   case AGX_OPCODE_IMAGE_LOAD:
+      return s == -1 || s == 0;
+   case AGX_OPCODE_IMAGE_WRITE:
+      return s == 0;
+   default:
+      return false;
+   }
+}
+
+/*
+ * Move whatever lives in [base, base + n) to free registers elsewhere,
+ * recording the copies. Fails, changing nothing, if there is no room.
+ */
+static bool
+g11_evict_range(struct ra_ctx *rctx, unsigned base, unsigned n,
+                struct util_dynarray *copies)
+{
+   BITSET_WORD *used = rctx->used_regs[RA_GPR];
+   unsigned vars[G11_LOW_REGS], homes[G11_LOW_REGS], nr = 0;
+   bool ok = true;
+
+   /* Occupants fully inside the range, since vectors are aligned to size */
+   for (unsigned r = base; r < base + n; ++r) {
+      if (!BITSET_TEST(used, r))
+         continue;
+
+      unsigned var = rctx->reg_to_ssa[r];
+      unsigned k = rctx->ncomps[var];
+      if (rctx->ssa_to_reg[var] != r || k > n)
+         return false;
+
+      vars[nr++] = var;
+      r += k - 1;
+   }
+
+   /* Find homes outside the range, reserving as we go */
+   BITSET_SET_COUNT(used, base, n);
+
+   for (unsigned i = 0; i < nr && ok; ++i) {
+      ok = find_regs_simple(rctx, RA_GPR, rctx->ncomps[vars[i]],
+                            rctx->ncomps[vars[i]], &homes[i]);
+      if (ok)
+         BITSET_SET_COUNT(used, homes[i], rctx->ncomps[vars[i]]);
+      else
+         nr = i;
+   }
+
+   BITSET_CLEAR_COUNT(used, base, n);
+
+   for (unsigned i = 0; i < nr; ++i) {
+      unsigned k = rctx->ncomps[vars[i]];
+
+      if (ok) {
+         insert_copy(rctx, copies, homes[i], vars[i]);
+         BITSET_CLEAR_COUNT(used, rctx->ssa_to_reg[vars[i]], k);
+         BITSET_SET_COUNT(used, homes[i], k);
+         set_ssa_to_reg(rctx, vars[i], homes[i]);
+      } else {
+         BITSET_CLEAR_COUNT(used, homes[i], k);
+      }
+   }
+
+   return ok;
+}
+
+/*
+ * Find an aligned range of n registers in r0-r31 avoiding the reserved
+ * registers and those in pinned, emptying it. Returns ~0 if impossible.
+ */
+static unsigned
+g11_low_range(struct ra_ctx *rctx, unsigned n, const BITSET_WORD *pinned,
+              struct util_dynarray *copies)
+{
+   unsigned best = ~0, best_used = ~0;
+   unsigned top = MIN2(G11_LOW_REGS, rctx->bound[RA_GPR]);
+
+   for (unsigned base = 0; base + n <= top; base += n) {
+      if (base < reserved_size(rctx->shader) ||
+          BITSET_TEST_RANGE(pinned, base, base + n - 1))
+         continue;
+
+      unsigned nr_used = 0;
+      for (unsigned r = base; r < base + n; ++r)
+         nr_used += BITSET_TEST(rctx->used_regs[RA_GPR], r);
+
+      if (nr_used < best_used) {
+         best = base;
+         best_used = nr_used;
+      }
+   }
+
+   if (best == ~0 || !g11_evict_range(rctx, best, n, copies))
+      return ~0;
+
+   return best;
+}
+
+static void
+g11_emit_copies(struct ra_ctx *rctx, agx_instr *I, struct util_dynarray *copies)
+{
+   agx_builder b = agx_init_builder(rctx->shader, agx_before_instr(I));
+   agx_emit_parallel_copies(
+      &b, copies->data, util_dynarray_num_elements(copies, struct agx_copy));
+   util_dynarray_fini(copies);
+}
+
+/*
+ * Move the low-register sources of a G11 sample or image write into r0-r31
+ * before it. ponytail: if there is no room the operand stays high and reads
+ * the wrong register
+ */
+static void
+g11_lower_sources(struct ra_ctx *rctx, agx_instr *I, BITSET_WORD *pinned)
+{
+   struct util_dynarray copies = UTIL_DYNARRAY_INIT;
+
+   agx_foreach_ssa_src(I, s) {
+      if (!g11_low_operand(I, s) || I->src[s].memory)
+         continue;
+
+      unsigned var = I->src[s].value;
+      unsigned old = rctx->ssa_to_reg[var], n = rctx->ncomps[var];
+
+      if (old + n <= G11_LOW_REGS) {
+         BITSET_SET_COUNT(pinned, old, n);
+         continue;
+      }
+
+      unsigned reg = g11_low_range(rctx, n, pinned, &copies);
+      if (reg == ~0)
+         continue;
+
+      insert_copy(rctx, &copies, reg, var);
+      BITSET_CLEAR_COUNT(rctx->used_regs[RA_GPR], old, n);
+      BITSET_SET_COUNT(rctx->used_regs[RA_GPR], reg, n);
+      BITSET_SET_COUNT(pinned, reg, n);
+      set_ssa_to_reg(rctx, var, reg);
+   }
+
+   g11_emit_copies(rctx, I, &copies);
+}
+
+/* Pick a destination in r0-r31 for a G11 sample, freeing one if needed */
+static unsigned
+g11_low_dest(struct ra_ctx *rctx, agx_instr *I, unsigned reg, unsigned n,
+             const BITSET_WORD *pinned)
+{
+   if (reg + n <= G11_LOW_REGS)
+      return reg;
+
+   struct util_dynarray copies = UTIL_DYNARRAY_INIT;
+   unsigned low = g11_low_range(rctx, n, pinned, &copies);
+
+   g11_emit_copies(rctx, I, &copies);
+
+   return low == ~0 ? reg : low;
+}
