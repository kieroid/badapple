+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *id = nir_load_global_invocation_id(b, 32);
+   nir_def *size = nir_imul(b, nir_load_num_workgroups(b), nir_load_workgroup_size(b));
+   nir_def *index = nir_iadd(
+      b, nir_channel(b, id, 0),
+      nir_imul(b, nir_channel(b, size, 0),
+               nir_iadd(b, nir_channel(b, id, 1),
+                        nir_imul(b, nir_channel(b, size, 1), nir_channel(b, id, 2)))));
+   nir_def *offset = nir_iadd(b, nir_imul_imm(b, index, stride),
+                              intr->src[store ? 1 : 0].ssa);
+   nir_def *addr = nir_iadd(b, nir_load_scratch_base_ptr(b, 1, 64, 0),
+                            nir_u2u64(b, offset));
