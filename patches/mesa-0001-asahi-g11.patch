+         nir_intrinsic_instr *h = nir_src_as_intrinsic(tex->src[s].src);
+         if (h && h->intrinsic == nir_intrinsic_bindless_sampler_agx) {
+            int slot = hk_g11_slot(info->g11_samp, &info->g11_nr_samp,
+                                   HK_G11_MAX_SAMPLERS, h);
+            tex->sampler_index = 1 + MAX2(slot, 0);
+
+            /* Only sampling reads it, and the preamble would turn it into
+             * a heap index the compiler can't tell apart
+             */
+            nir_tex_instr_remove_src(tex, s);
+            progress = true;
+         }
+      }
