+/*
+ * G11 lowering, late so that nothing re-forms what it splits:
+ *
+ * - G11 flushes half denormals wherever an f16 value meets the hardware, but
+ *   f16 <-> f32 conversions must be exact. Handle the denormal range with
+ *   integer and f32 arithmetic and keep the hardware conversion for the rest.
+ * - G11 has no srsqrt, so sqrt is x * rsqrt(x) with 0 and inf passed through.
+ * - Nor roundeven: round floor(x) up when the rest is over a half, or a half
+ *   with floor(x) odd. Nor trunc: floor(|x|) with x's sign, which NIR's own
+ *   lowering loses for -0. agx_nir_options lowers ceil to -floor(-x).
+ */
+/* f16 -> f32 that keeps half denormals: sign | 0 | mantissa is
+ * +-mantissa * 2^-24, the rest is the hardware conversion.
+ */
+static nir_def *
+exact_f2f32(nir_builder *b, nir_def *x)
+{
+   nir_def *bits = nir_u2u32(b, x);
+   nir_def *den = nir_fmul_imm(b, nir_u2f32(b, nir_iand_imm(b, bits, 0x3ff)),
+                               0x1p-24);
+   den = nir_bcsel(b, nir_test_mask(b, bits, 0x8000), nir_fneg(b, den), den);
+   return nir_bcsel(b, nir_ieq_imm(b, nir_iand_imm(b, bits, 0x7c00), 0), den,
+                    nir_f2f32(b, x));
+}
+
+static bool
+lower_g11_alu(nir_builder *b, nir_alu_instr *alu, UNUSED void *data)
+{
+   nir_def *x = alu->src[0].src.ssa;
+   bool to_f32 = alu->op == nir_op_f2f32 && x->bit_size == 16;
+
+   /* f16 compares see denormals as zero, which breaks libclc's rtp and rtn
+    * conversions: compare in f32 instead.
+    */
+   if (nir_alu_instr_is_comparison(alu) && x->bit_size == 16 &&
+       nir_alu_type_get_base_type(nir_op_infos[alu->op].input_types[0]) ==
+          nir_type_float) {
+      b->cursor = nir_before_instr(&alu->instr);
+      nir_def *srcs[2];
+      for (unsigned i = 0; i < 2; ++i)
+         srcs[i] = exact_f2f32(b, nir_ssa_for_alu_src(b, alu, i));
+      nir_def_replace(&alu->def, nir_build_alu2(b, alu->op, srcs[0], srcs[1]));
+      return true;
+   }
+
+   if (alu->op == nir_op_fround_even) {
+      b->cursor = nir_before_instr(&alu->instr);
+      x = nir_ssa_for_alu_src(b, alu, 0);
+      unsigned sz = x->bit_size;
+      nir_def *f = nir_ffloor(b, x);
+      nir_def *d = nir_fadd(b, x, nir_fneg(b, f));
+      nir_def *h = nir_fmul_imm(b, f, 0.5);
+      nir_def *odd = nir_fneu(b, nir_ffloor(b, h), h);
+      nir_def *up = nir_ior(b, nir_flt(b, nir_imm_floatN_t(b, 0.5, sz), d),
+                            nir_iand(b, nir_feq_imm(b, d, 0.5), odd));
+      nir_def *r = nir_fadd(b, f, nir_bcsel(b, up, nir_imm_floatN_t(b, 1.0, sz),
+                                             nir_imm_floatN_t(b, 0.0, sz)));
+      /* A zero result keeps x's sign */
+      nir_def *sign = nir_iand_imm(b, x, 1ull << (sz - 1));
+      nir_def_replace(&alu->def,
+                      nir_bcsel(b, nir_feq_imm(b, r, 0.0), sign, r));
+      return true;
+   }
+
+   if (alu->op == nir_op_ftrunc) {
+      b->cursor = nir_before_instr(&alu->instr);
+      x = nir_ssa_for_alu_src(b, alu, 0);
+      nir_def *sign = nir_iand_imm(b, x, 1ull << (x->bit_size - 1));
+      nir_def_replace(&alu->def, nir_ior(b, nir_ffloor(b, nir_fabs(b, x)), sign));
+      return true;
+   }
+
+   if (alu->op == nir_op_fsqrt) {
+      b->cursor = nir_before_instr(&alu->instr);
+      x = nir_ssa_for_alu_src(b, alu, 0);
+      nir_def *edge = nir_ior(b, nir_feq_imm(b, x, 0.0),
+                              nir_feq_imm(b, x, INFINITY));
+      nir_def_replace(&alu->def,
+                      nir_bcsel(b, edge, x, nir_fmul(b, x, nir_frsq(b, x))));
+      return true;
+   }
+
+   if (to_f32) {
+      b->cursor = nir_before_instr(&alu->instr);
+      nir_def_replace(&alu->def, exact_f2f32(b, nir_ssa_for_alu_src(b, alu, 0)));
+      return true;
+   }
+
+   if (alu->op != nir_op_f2f16 && alu->op != nir_op_f2f16_rtne)
+      return false;
+
+   b->cursor = nir_after_instr(&alu->instr);
+   x = nir_ssa_for_alu_src(b, alu, 0);
+
+   /*
+    * Below 2^-14 the result is |x| in units of 2^-24, rounded to even,
+    * with x's sign: the 24-bit mantissa shifted right by 126 - exponent.
+    * Integer only, since G11 has no round instruction. Shifts clamp at
+    * 31, where the mantissa rounds to 0.
+    */
+   nir_def *e = nir_iand_imm(b, nir_ushr_imm(b, x, 23), 0xff);
+   nir_def *mant = nir_ior_imm(b, nir_iand_imm(b, x, 0x7fffff), 0x800000);
+   nir_def *s = nir_isub(b, nir_imm_int(b, 126), e);
+   s = nir_bcsel(b, nir_ult_imm(b, s, 31), s, nir_imm_int(b, 31));
+   nir_def *q = nir_ushr(b, mant, s);
+   nir_def *rem =
+      nir_iand(b, mant, nir_iadd_imm(b, nir_ishl(b, nir_imm_int(b, 1), s), -1));
+   nir_def *half = nir_ishl(b, nir_imm_int(b, 1), nir_iadd_imm(b, s, -1));
+   nir_def *up = nir_ior(b, nir_ult(b, half, rem),
+                         nir_iand(b, nir_ieq(b, rem, half), nir_test_mask(b, q, 1)));
+   q = nir_iadd(b, q, nir_bcsel(b, up, nir_imm_int(b, 1), nir_imm_int(b, 0)));
+   nir_def *sign = nir_ushr_imm(b, nir_iand_imm(b, x, 0x80000000), 16);
+   nir_def *den = nir_u2u16(b, nir_ior(b, q, sign));
+   nir_def *res =
+      nir_bcsel(b, nir_flt_imm(b, nir_fabs(b, x), 0x1p-14), den, &alu->def);
+
+   nir_def_rewrite_uses_after(&alu->def, res);
+   return true;
+}
