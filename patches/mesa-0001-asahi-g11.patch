+/*
+ * G11 samples from state slots fixed at compile time (hk_g11_lower_handles),
+ * so a descriptor array indexed at run time becomes a chain of accesses with
+ * constant indices. Only 16 textures fit, so indices past 16 read zero, as do
+ * indices past the array.
+ */
+static bool
+hk_g11_unroll_index(nir_builder *b, nir_instr *instr, UNUSED void *data)
+{
+   nir_deref_instr *d = NULL;
+   nir_def *def = NULL, *index;
+   unsigned src, len;
+
+   if (instr->type == nir_instr_type_tex) {
+      nir_tex_instr *tex = nir_instr_as_tex(instr);
+      int o = nir_tex_instr_src_index(tex, nir_tex_src_texture_offset);
+      int t = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+      int s = nir_tex_instr_src_index(tex, nir_tex_src_sampler_deref);
+      def = &tex->def;
+
+      if (o >= 0 && !nir_src_is_const(tex->src[o].src)) {
+         /* Arrayed input attachments */
+         src = o;
+         index = tex->src[o].src.ssa;
+         len = tex->texture_array_size;
+      } else if (t >= 0 && (d = hk_g11_dynamic_deref(tex->src[t].src))) {
+         src = t;
+      } else if (s >= 0 && (d = hk_g11_dynamic_deref(tex->src[s].src))) {
+         src = s;
+      } else {
+         return false;
+      }
+   } else if (instr->type == nir_instr_type_intrinsic) {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      switch (intr->intrinsic) {
