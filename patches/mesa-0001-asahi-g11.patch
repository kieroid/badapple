+      agx_is_indirect(draw.b)
+         ? AGX_G11_HEAP_INDIRECT
+         : agx_g11_heap_cost((uint64_t)draw.b.count[0] * draw.b.count[1],
+                             hk_g11_outputs(cmd));
+   struct hk_cs *cs = cmd->current_cs.gfx;
+
+   if (cs && cs->g11_heap_B && cs->g11_heap_B + cost > AGX_G11_HEAP_BUDGET) {
+      perf_debug(cmd, "Splitting control stream for the G11 tiler heap");
+      hk_cmd_buffer_end_graphics(cmd);
+   }
+
+   cs = hk_cmd_buffer_get_cs(cmd, false /* compute */);
+   if (cs)
+      cs->g11_heap_B += cost;
+}
