+/*
+ * Target the A12 GPU (G11). In the compiler: the stop instruction is 0x0801,
+ * threadgroup memory goes through the device load/store encoding, and there
+ * are no SIMD reductions or G13 cache barriers. In command streams: CDM
+ * block types sit in bits 31:30, and the USC shader, register and shared
+ * memory words are one word. cmdbuf.xml has the G11 encodings.
+ */
+#define AGX_G11 1
