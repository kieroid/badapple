+/*
+ * G11 kills the thread on stack_load/stack_store, so spill to threadgroup
+ * memory instead: each thread gets spill_stride bytes, stacked down
+ * from AGX_G11_SPILL_TOP. Nothing is live at entry, so r1-r3 (reserved by RA
+ * when spilling) are free to compute the base,
+ * r3l = TOP - (local_index + 1) * stride.
+ */
+static void
+g11_spill_base(agx_context *ctx)
+{
+   assert(ctx->stage == MESA_SHADER_COMPUTE && !ctx->is_preamble);
+   assert(ctx->has_spill_pcopy_reserved);
+
+   unsigned stride = align(ctx->scratch_size_B, 16);
+   agx_index r1 = agx_register(2, AGX_SIZE_32);
+   agx_index r2 = agx_register(4, AGX_SIZE_32);
+   agx_index r3 = agx_register(6, AGX_SIZE_32);
+   agx_builder b = agx_init_builder(ctx, agx_before_block(agx_start_block(ctx)));
+
+   agx_get_sr_to(&b, r1, AGX_SR_THREAD_POSITION_IN_THREADGROUP_X + 2);
+   agx_get_sr_to(&b, r2, AGX_SR_THREADS_PER_THREADGROUP_X + 1);
+   agx_get_sr_to(&b, r3, AGX_SR_THREAD_POSITION_IN_THREADGROUP_X + 1);
+   agx_imad_to(&b, r1, r1, r2, r3, 0);
+   agx_get_sr_to(&b, r2, AGX_SR_THREADS_PER_THREADGROUP_X);
+   agx_get_sr_to(&b, r3, AGX_SR_THREAD_POSITION_IN_THREADGROUP_X);
+   agx_imad_to(&b, r1, r1, r2, r3, 0);
+   agx_mov_imm_to(&b, r2, (uint32_t)-stride);
+   agx_mov_imm_to(&b, r3, AGX_G11_SPILL_TOP - stride);
+   agx_imad_to(&b, r3, r1, r2, r3, 0);
+
+   ctx->max_reg = MAX2(ctx->max_reg, 7);
+   ctx->out->spill_stride = stride;
+}
