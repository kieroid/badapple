diff --git a/drivers/hwmon/apple-soc-temp.c b/drivers/hwmon/apple-soc-temp.c
new file mode 100644
index 000000000..83b46657f
--- /dev/null
+++ b/drivers/hwmon/apple-soc-temp.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple SoC die temperature sensors
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ *
+ * The ADT calls these tempsensor0 to tempsensor8 on T8020 and gives every
+ * register offset by name. Two kinds, which is why there are two compatibles:
+ * the PMGR die sensors are 32 bit and evenly spaced, the CPU cluster ones are
+ * 64 bit and are not.
+ *
+ * Each sensor can accumulate readings into a sum and a count, so a temperature
+ * is sum / count. readBK holds a single unaveraged reading and is what iBoot
+ * leaves behind, so in practice that is what gets read.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/hwmon.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+/*
+ * A read holds two 16 bit fields. The low one is the temperature in 1/64 of a
+ * degree, the high one is the raw diode code, which falls as the low one
+ * rises. Only the low one is of any use here.
+ */
+#define TEMP_READ_VALUE		GENMASK(15, 0)
+#define TEMP_READ_SHIFT		6
+
+struct apple_temp_sensor {
+	const char *label;
+	u32 sum;
+	u32 cnt;
+	u32 read_bk;
+};
+
+struct apple_temp_soc {
+	const struct apple_temp_sensor *sensors;
+	unsigned int count;
+	bool wide;
+};
+
+/*
+ * /arm-io/tempsensor0 to 4. One block, 0x4000 per sensor, averaged reads
+ * 0x20000 further up.
+ */
+static const struct apple_temp_sensor t8020_pmgr_sensors[] = {
+	{ "SOC die 0", 0x00028, 0x00030, 0x20000 },
+	{ "SOC die 1", 0x04028, 0x04030, 0x24000 },
+	{ "SOC die 2", 0x08028, 0x08030, 0x28000 },
+	{ "SOC die 3", 0x0c028, 0x0c030, 0x2c000 },
+	{ "SOC die 4", 0x10028, 0x10030, 0x30000 },
+};
+
+/*
+ * /arm-io/tempsensor5 to 7, the P cluster and its two cores. The spacing is
+ * 0x40 and then 0x200, which is why these are a table and not a stride.
+ */
+static const struct apple_temp_sensor t8020_acc_sensors[] = {
+	{ "ACC",   0x030, 0x038, 0x4000 },
+	{ "ACCp0", 0x070, 0x078, 0x4010 },
+	{ "ACCp1", 0x230, 0x238, 0x4020 },
+};
+
+/* /arm-io/tempsensor8, the E cluster, same offsets at its own base. */
+static const struct apple_temp_sensor t8020_acce_sensors[] = {
+	{ "ACCe", 0x030, 0x038, 0x4000 },
+};
+
+static const struct apple_temp_soc t8020_pmgr = {
+	.sensors = t8020_pmgr_sensors,
+	.count = ARRAY_SIZE(t8020_pmgr_sensors),
+};
+
+static const struct apple_temp_soc t8020_acc = {
+	.sensors = t8020_acc_sensors,
+	.count = ARRAY_SIZE(t8020_acc_sensors),
+	.wide = true,
+};
+
+static const struct apple_temp_soc t8020_acce = {
+	.sensors = t8020_acce_sensors,
+	.count = ARRAY_SIZE(t8020_acce_sensors),
+	.wide = true,
+};
+
+struct apple_temp {
+	void __iomem *base;
+	const struct apple_temp_soc *soc;
+	/* which sensors of the block are actually running, see probe */
+	const struct apple_temp_sensor *live[ARRAY_SIZE(t8020_pmgr_sensors)];
+	unsigned int live_count;
+};
+
+static u64 apple_temp_read_reg(struct apple_temp *temp, u32 offset)
+{
+	if (temp->soc->wide)
+		return readq_relaxed(temp->base + offset);
+
+	return readl_relaxed(temp->base + offset);
+}
+
+/*
+ * Averaged if the hardware has been accumulating, otherwise the single read.
+ * iBoot leaves the accumulators at zero, so in practice this is the single
+ * read, but a sum is better when there is one.
+ */
+static u64 apple_temp_raw(struct apple_temp *temp, const struct apple_temp_sensor *sensor)
+{
+	u64 sum = apple_temp_read_reg(temp, sensor->sum);
+	u64 cnt = apple_temp_read_reg(temp, sensor->cnt);
+
+	if (cnt)
+		return div64_u64(sum, cnt);
+
+	return apple_temp_read_reg(temp, sensor->read_bk);
+}
+
+static int apple_temp_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+				 u32 attr, int channel, long *val)
+{
+	struct apple_temp *temp = dev_get_drvdata(dev);
+
+	if (type != hwmon_temp || attr != hwmon_temp_input)
+		return -EOPNOTSUPP;
+
+	/* millidegrees, from a reading in 1/64 of a degree */
+	*val = (FIELD_GET(TEMP_READ_VALUE, apple_temp_raw(temp, temp->live[channel])) * 1000)
+		>> TEMP_READ_SHIFT;
+
+	return 0;
+}
+
+static int apple_temp_hwmon_read_string(struct device *dev, enum hwmon_sensor_types type,
+					u32 attr, int channel, const char **str)
+{
+	struct apple_temp *temp = dev_get_drvdata(dev);
+
+	if (type != hwmon_temp || attr != hwmon_temp_label)
+		return -EOPNOTSUPP;
+
+	*str = temp->live[channel]->label;
+
+	return 0;
+}
+
+static umode_t apple_temp_hwmon_is_visible(const void *data, enum hwmon_sensor_types type,
+					   u32 attr, int channel)
+{
+	return type == hwmon_temp ? 0444 : 0;
+}
+
+static const struct hwmon_ops apple_temp_hwmon_ops = {
+	.is_visible = apple_temp_hwmon_is_visible,
+	.read = apple_temp_hwmon_read,
+	.read_string = apple_temp_hwmon_read_string,
+};
+
+static int apple_temp_probe(struct platform_device *pdev)
+{
+	struct hwmon_channel_info *info;
+	struct hwmon_chip_info *chip;
+	const u32 **info_list;
+	struct apple_temp *temp;
+	struct device *hwmon;
+	u32 *config;
+	unsigned int i;
+
+	temp = devm_kzalloc(&pdev->dev, sizeof(*temp), GFP_KERNEL);
+	if (!temp)
+		return -ENOMEM;
+
+	temp->soc = of_device_get_match_data(&pdev->dev);
+	if (!temp->soc)
+		return -ENODEV;
+
+	temp->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(temp->base))
+		return PTR_ERR(temp->base);
+
+	chip = devm_kzalloc(&pdev->dev, sizeof(*chip), GFP_KERNEL);
+	info = devm_kzalloc(&pdev->dev, sizeof(*info), GFP_KERNEL);
+	info_list = devm_kcalloc(&pdev->dev, 2, sizeof(*info_list), GFP_KERNEL);
+	config = devm_kcalloc(&pdev->dev, temp->soc->count + 1, sizeof(*config), GFP_KERNEL);
+	if (!chip || !info || !info_list || !config)
+		return -ENOMEM;
+
+	/*
+	 * Not every sensor in a block is running. On D331p, PMGR sensor 2
+	 * reads zero in both its status and its value while the other four
+	 * read sensible temperatures, so skip whatever reads nothing rather
+	 * than publish a channel stuck at 0 degrees.
+	 */
+	for (i = 0; i < temp->soc->count; i++) {
+		const struct apple_temp_sensor *sensor = &temp->soc->sensors[i];
+
+		if (!apple_temp_raw(temp, sensor)) {
+			dev_info(&pdev->dev, "%s: reads zero, skipped\n", sensor->label);
+			continue;
+		}
+
+		config[temp->live_count] = HWMON_T_INPUT | HWMON_T_LABEL;
+		temp->live[temp->live_count++] = sensor;
+	}
+
+	if (!temp->live_count)
+		return -ENODEV;
+
+	info->type = hwmon_temp;
+	info->config = config;
+	info_list[0] = (const u32 *)info;
+	chip->ops = &apple_temp_hwmon_ops;
+	chip->info = (const struct hwmon_channel_info * const *)info_list;
+
+	platform_set_drvdata(pdev, temp);
+
+	hwmon = devm_hwmon_device_register_with_info(&pdev->dev, "apple_soc_temp",
+						    temp, chip, NULL);
+
+	return PTR_ERR_OR_ZERO(hwmon);
+}
+
+static const struct of_device_id apple_temp_of_table[] = {
+	{ .compatible = "apple,t8020-pmgr-tempsensor", .data = &t8020_pmgr },
+	{ .compatible = "apple,t8020-acc-tempsensor", .data = &t8020_acc },
+	{ .compatible = "apple,t8020-acce-tempsensor", .data = &t8020_acce },
+	{}
+};
+MODULE_DEVICE_TABLE(of, apple_temp_of_table);
+
+static struct platform_driver apple_temp_driver = {
+	.probe = apple_temp_probe,
+	.driver = {
+		.name = "apple-soc-temp",
+		.of_match_table = apple_temp_of_table,
+	},
+};
+module_platform_driver(apple_temp_driver);
+
+MODULE_DESCRIPTION("Apple SoC die temperature sensors");
+MODULE_LICENSE("GPL");
