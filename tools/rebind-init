#!/bin/busybox sh
# Force the USB gadget to present itself to whatever host is attached, then
# hand over to the real init.
#
# Shebang matters: this runs as rdinit=, before Hoolock's /init has done
# "/bin/busybox --install -s", so /bin/sh does not exist yet. The only things
# in the archive at this point are /init, /bin/busybox, musl and
# extract.cpio.lzma, which /init unpacks to produce the real rootfs. A failed
# rdinit= panics the kernel, which looks like a flash and an instant reboot.
#
# For the same reason this uses shell builtins and globbing only: no ls, no
# cat, no head, since those applets are not linked yet either.
#
# Why it exists at all: the phone must sit on the l41ka jig for the whole
# usbliter8 chain, because the RP2350 is the USB host that runs the exploit.
# dwc2 probes about 0.26s into the kernel. Moving the cable to the PC later
# never enumerates, and moving it before the handoff does not either, because
# this device tree wires no VBUS or session detection, so dwc2 has nothing to
# tell it a session started and never raises its pullup.
#
# Writing "" to the gadget's UDC attribute unbinds it and drops the pullup;
# writing the controller name back raises it again, which looks like a fresh
# plug to whichever host is now attached. That is what enumerated: 05ac:12a8
# with a working CDC interface.
#
# Stop once a host has configured us. Rebinding a live connection tears it
# down again, and doing that on a timer killed the phone outright.
#
# The A11 port needs none of this: checkm8 runs from the PC, so the phone is
# attached to the PC for the entire boot.

# Hoolock mounts configfs at /config, not /sys/kernel/config: see CONFIGFS in
# its init_functions.sh. Check both so this does not silently do nothing.
find_gadget() {
	for base in /config/usb_gadget /sys/kernel/config/usb_gadget; do
		if [ -d "$base/g1" ]; then
			echo "$base/g1"
			return
		fi
	done
}

log() {
	echo "[rebind] $*" > /dev/kmsg 2>/dev/null
}

rebind_loop() {
	# Let the real init finish unpacking the rootfs and its configfs setup.
	sleep 15

	while true; do
		udc=
		for d in /sys/class/udc/*; do
			[ -e "$d" ] || continue
			udc=${d##*/}
			break
		done

		gadget=$(find_gadget)

		state=
		[ -n "$udc" ] && read -r state < "/sys/class/udc/$udc/state" 2>/dev/null

		if [ -z "$udc" ] || [ -z "$gadget" ]; then
			log "waiting: udc='$udc' gadget='$gadget'"
		elif [ "$state" = "configured" ]; then
			log "configured, leaving it alone"
		else
			log "state='$state', rebinding $udc on $gadget"
			echo "" > "$gadget/UDC" 2>/dev/null
			sleep 1
			echo "$udc" > "$gadget/UDC" 2>/dev/null
			# Give the host time to see the pullup, enumerate and
			# configure. Toggling every few seconds is shorter than
			# that takes, so it tears down each attempt in progress.
			sleep 20
		fi

		sleep 5
	done
}

# busybox sh opens /dev/null for a background job's stdin, and at rdinit time
# /dev does not exist yet: Hoolock's /init mounts it later. Without this the
# shell reports "line 0: can't open /dev/null: no such file", the background
# job never starts, and the boot looks completely normal with no rebind output.
# /dev/kmsg is for log() below. /init later mounts devtmpfs over the top, which
# replaces both with the real nodes.
/bin/busybox mkdir -p /dev
[ -e /dev/null ] || /bin/busybox mknod /dev/null c 1 3
[ -e /dev/kmsg ] || /bin/busybox mknod /dev/kmsg c 1 11

rebind_loop &

exec /init
